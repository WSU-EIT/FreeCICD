@* NuGet Package Inventory Component *@
@* Displays .csproj files, NuGet packages, and target frameworks across the entire Azure DevOps organization. *@
@* Uses SignalR for progressive loading status updates. *@

@implements IDisposable
@inject BlazorDataModel Model

@code {
    protected bool _loadedData = false;
    protected bool _loading = true;
    protected string _pageName = "nuget-inventory";
    protected DataObjects.NuGetInventoryResponse? _inventoryResponse;
    protected string? _errorMessage;
    protected string _loadingMessage = "Loading inventory...";

    // Filter state
    protected string _searchTerm = "";
    protected string _selectedFramework = "";
    protected bool _multiVersionOnly = false;

    // View state
    protected string _activeTab = "packages"; // packages, projects, frameworks

    // Sort state (packages tab)
    protected string _sortColumn = "name"; // name, versions, uses
    protected bool _sortAscending = true;

    // Expand state — project tree
    protected HashSet<string> _expandedProjects = [];
    protected HashSet<string> _expandedRepos = [];
    protected HashSet<string> _expandedBranches = [];
    protected HashSet<string> _expandedCsproj = [];

    // Expand state — packages tab drill-down
    protected HashSet<string> _expandedPackages = [];

    // Expand state — frameworks tab
    protected HashSet<string> _expandedFrameworks = [];

    // ── Helper: get all csproj files that reference a specific package ──
    protected List<(string Project, string Repo, string Branch, string CsprojPath, string? Framework, string Version)> GetPackageUsages(string packageName)
    {
        if (_inventoryResponse?.Projects == null) return [];

        return _inventoryResponse.Projects
            .SelectMany(p => p.Repos.SelectMany(r => r.Branches.SelectMany(b =>
                b.CsprojFiles.SelectMany(c =>
                    c.Packages.Where(pkg => string.Equals(pkg.Name, packageName, StringComparison.OrdinalIgnoreCase))
                        .Select(pkg => (Project: p.Name, Repo: r.Name, Branch: b.Name, CsprojPath: c.Path, Framework: c.TargetFramework, Version: pkg.Version))))))
            .OrderBy(x => x.Project).ThenBy(x => x.Repo).ThenBy(x => x.Branch).ThenBy(x => x.CsprojPath)
            .ToList();
    }

    // ── Helper: count csproj files per framework ──
    protected int GetFrameworkCsprojCount(string framework)
    {
        if (_inventoryResponse?.Projects == null) return 0;

        return _inventoryResponse.Projects
            .SelectMany(p => p.Repos.SelectMany(r => r.Branches.SelectMany(b => b.CsprojFiles)))
            .Count(c => string.Equals(c.TargetFramework, framework, StringComparison.OrdinalIgnoreCase));
    }

    // ── Helper: get set of package names used by projects targeting a specific framework ──
    protected HashSet<string>? _frameworkPackageNames;
    protected string? _frameworkPackageNamesKey;

    protected HashSet<string> GetPackageNamesForFramework(string framework)
    {
        if (_inventoryResponse?.Projects == null) return [];

        var key = framework.ToLower();
        if (_frameworkPackageNamesKey == key && _frameworkPackageNames != null) return _frameworkPackageNames;

        _frameworkPackageNames = _inventoryResponse.Projects
            .SelectMany(p => p.Repos.SelectMany(r => r.Branches.SelectMany(b =>
                b.CsprojFiles.Where(c => string.Equals(c.TargetFramework, framework, StringComparison.OrdinalIgnoreCase))
                    .SelectMany(c => c.Packages.Select(pkg => pkg.Name)))))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        _frameworkPackageNamesKey = key;
        return _frameworkPackageNames;
    }

    // Computed: total unfiltered counts for "Showing X of Y" display
    protected int TotalPackageCount => _inventoryResponse?.PackageSummary?.Count ?? 0;
    protected int TotalProjectCount => _inventoryResponse?.Projects?.Count ?? 0;
    protected int TotalFrameworkCount {
        get {
            if (_inventoryResponse?.Projects == null) return 0;
            return _inventoryResponse.Projects
                .SelectMany(p => p.Repos.SelectMany(r => r.Branches.SelectMany(b => b.CsprojFiles)))
                .Where(c => !string.IsNullOrEmpty(c.TargetFramework))
                .Select(c => c.TargetFramework!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count();
        }
    }

    // Computed: filtered and sorted package summary
    protected List<DataObjects.PackageSummaryItem> FilteredPackages {
        get {
            if (_inventoryResponse?.PackageSummary == null) return [];

            var packages = _inventoryResponse.PackageSummary.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchTerm)) {
                var search = _searchTerm.ToLower();
                packages = packages.Where(p =>
                    p.Name.ToLower().Contains(search) ||
                    p.Versions.Any(v => v.ToLower().Contains(search)));
            }

            if (_multiVersionOnly) {
                packages = packages.Where(p => p.HasMultipleVersions);
            }

            if (!string.IsNullOrWhiteSpace(_selectedFramework)) {
                var fwPackages = GetPackageNamesForFramework(_selectedFramework);
                packages = packages.Where(p => fwPackages.Contains(p.Name));
            }

            var list = packages.ToList();

            list = _sortColumn switch {
                "versions" => _sortAscending ? list.OrderBy(p => p.Versions.Count).ThenBy(p => p.Name).ToList()
                                             : list.OrderByDescending(p => p.Versions.Count).ThenBy(p => p.Name).ToList(),
                "uses"     => _sortAscending ? list.OrderBy(p => p.UsageCount).ThenBy(p => p.Name).ToList()
                                             : list.OrderByDescending(p => p.UsageCount).ThenBy(p => p.Name).ToList(),
                _          => _sortAscending ? list.OrderBy(p => p.Name).ToList()
                                             : list.OrderByDescending(p => p.Name).ToList()
            };

            return list;
        }
    }

    // Computed: filtered projects for tree view
    protected List<DataObjects.ProjectInventory> FilteredProjects {
        get {
            if (_inventoryResponse?.Projects == null) return [];

            var projects = _inventoryResponse.Projects.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchTerm)) {
                var search = _searchTerm.ToLower();
                projects = projects.Where(p =>
                    p.Name.ToLower().Contains(search) ||
                    p.Repos.Any(r => r.Name.ToLower().Contains(search) ||
                        r.Branches.Any(b => b.CsprojFiles.Any(c =>
                            c.Path.ToLower().Contains(search) ||
                            c.Packages.Any(pkg => pkg.Name.ToLower().Contains(search))))));
            }

            if (!string.IsNullOrWhiteSpace(_selectedFramework)) {
                projects = projects.Where(p =>
                    p.Repos.Any(r => r.Branches.Any(b =>
                        b.CsprojFiles.Any(c => string.Equals(c.TargetFramework, _selectedFramework, StringComparison.OrdinalIgnoreCase)))));
            }

            if (_multiVersionOnly) {
                var multiVersionNames = _inventoryResponse.PackageSummary?
                    .Where(p => p.HasMultipleVersions).Select(p => p.Name).ToHashSet(StringComparer.OrdinalIgnoreCase) ?? [];

                projects = projects.Where(p =>
                    p.Repos.Any(r => r.Branches.Any(b =>
                        b.CsprojFiles.Any(c =>
                            c.Packages.Any(pkg => multiVersionNames.Contains(pkg.Name))))));
            }

            return projects.ToList();
        }
    }

    // Computed: filtered framework groups
    protected List<IGrouping<string, (string Project, string Repo, string Csproj, string Framework)>> FrameworkGroups {
        get {
            if (_inventoryResponse?.Projects == null) return [];

            var items = _inventoryResponse.Projects
                .SelectMany(p => p.Repos.SelectMany(r => r.Branches.SelectMany(b =>
                    b.CsprojFiles.Where(c => !string.IsNullOrEmpty(c.TargetFramework))
                        .Select(c => (Project: p.Name, Repo: r.Name, Csproj: c.Path, Framework: c.TargetFramework!)))))
                .AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchTerm)) {
                var search = _searchTerm.ToLower();
                items = items.Where(x =>
                    x.Project.ToLower().Contains(search) ||
                    x.Repo.ToLower().Contains(search) ||
                    x.Csproj.ToLower().Contains(search) ||
                    x.Framework.ToLower().Contains(search));
            }

            if (!string.IsNullOrWhiteSpace(_selectedFramework)) {
                items = items.Where(x => string.Equals(x.Framework, _selectedFramework, StringComparison.OrdinalIgnoreCase));
            }

            return items
                .GroupBy(x => x.Framework, StringComparer.OrdinalIgnoreCase)
                .OrderBy(g => g.Key)
                .ToList();
        }
    }

    public void Dispose()
    {
        Model.OnChange -= OnDataModelUpdated;
        Model.OnSignalRUpdate -= OnSignalRUpdate;
    }

    protected override void OnInitialized()
    {
        Model.OnChange += OnDataModelUpdated;
        Model.OnSignalRUpdate += OnSignalRUpdate;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Model.Loaded && Model.LoggedIn) {
            if (!_loadedData) {
                _loadedData = true;
                await LoadInventory();
            }
        }
    }

    protected void OnSignalRUpdate(DataObjects.SignalRUpdate update)
    {
        if (update == null) return;

        switch (update.UpdateType) {
            case DataObjects.SignalRUpdateType.LoadingDevOpsInfoStatusUpdate:
                if (!string.IsNullOrWhiteSpace(update.Message)) {
                    _loadingMessage = update.Message;
                    InvokeAsync(StateHasChanged);
                }
                break;

            case DataObjects.SignalRUpdateType.NuGetInventoryLoadComplete:
                _loading = false;
                if (!string.IsNullOrWhiteSpace(update.Message)) {
                    _loadingMessage = update.Message;
                }
                InvokeAsync(StateHasChanged);
                break;
        }
    }

    protected void OnDataModelUpdated()
    {
        if (Model.View == _pageName) {
            StateHasChanged();
        }
    }

    protected async Task LoadInventory()
    {
        _loading = true;
        _errorMessage = null;
        _loadingMessage = "Connecting to Azure DevOps...";
        StateHasChanged();

        try {
            var response = await Helpers.GetOrPost<DataObjects.NuGetInventoryResponse>(
                DataObjects.Endpoints.NuGetInventory.GetInventory +
                "?connectionId=" + Uri.EscapeDataString((string.Empty + Model?.SignalrClientRegistration?.ConnectionId).Trim()));

            if (response != null) {
                _inventoryResponse = response;
                _frameworkPackageNames = null;
                _frameworkPackageNamesKey = null;
                if (!response.Success && !string.IsNullOrWhiteSpace(response.ErrorMessage)) {
                    _errorMessage = response.ErrorMessage;
                }
            } else {
                _errorMessage = "Failed to load NuGet inventory. Please try again.";
            }
        } catch (Exception ex) {
            _errorMessage = $"Error loading inventory: {ex.Message}";
        } finally {
            _loading = false;
            StateHasChanged();
        }
    }

    protected async Task RefreshInventory()
    {
        _loadedData = false;
        _inventoryResponse = null;
        _loadingMessage = "Loading inventory...";
        await LoadInventory();
    }

    protected void SetActiveTab(string tab)
    {
        _activeTab = tab;
        StateHasChanged();
    }

    protected void SortPackages(string column)
    {
        if (_sortColumn == column) {
            _sortAscending = !_sortAscending;
        } else {
            _sortColumn = column;
            _sortAscending = column == "name"; // default ascending for name, descending for numeric
        }
    }

    protected string GetSortIcon(string column)
    {
        if (_sortColumn != column) return "fa-sort";
        return _sortAscending ? "fa-sort-up" : "fa-sort-down";
    }

    protected void TogglePackage(string packageName)
    {
        if (_expandedPackages.Contains(packageName)) {
            _expandedPackages.Remove(packageName);
        } else {
            _expandedPackages.Add(packageName);
        }
    }

    protected void ToggleProject(string projectId)
    {
        if (_expandedProjects.Contains(projectId)) {
            _expandedProjects.Remove(projectId);
        } else {
            _expandedProjects.Add(projectId);
        }
    }

    protected void ToggleRepo(string repoKey)
    {
        if (_expandedRepos.Contains(repoKey)) {
            _expandedRepos.Remove(repoKey);
        } else {
            _expandedRepos.Add(repoKey);
        }
    }

    protected void ToggleBranch(string branchKey)
    {
        if (_expandedBranches.Contains(branchKey)) {
            _expandedBranches.Remove(branchKey);
        } else {
            _expandedBranches.Add(branchKey);
        }
    }

    protected void ToggleCsproj(string csprojKey)
    {
        if (_expandedCsproj.Contains(csprojKey)) {
            _expandedCsproj.Remove(csprojKey);
        } else {
            _expandedCsproj.Add(csprojKey);
        }
    }

    protected void ToggleFramework(string framework)
    {
        if (_expandedFrameworks.Contains(framework)) {
            _expandedFrameworks.Remove(framework);
        } else {
            _expandedFrameworks.Add(framework);
        }
    }

    protected void ExpandAll()
    {
        if (_inventoryResponse?.Projects != null) {
            foreach (var p in _inventoryResponse.Projects) {
                _expandedProjects.Add(p.Id);
                foreach (var r in p.Repos) {
                    var repoKey = p.Id + "/" + r.Id;
                    _expandedRepos.Add(repoKey);
                    foreach (var b in r.Branches) {
                        _expandedBranches.Add(repoKey + "/" + b.Name);
                    }
                }
            }
        }
    }

    protected void CollapseAll()
    {
        _expandedProjects.Clear();
        _expandedRepos.Clear();
        _expandedBranches.Clear();
        _expandedCsproj.Clear();
    }
}

@* ════════════════════════════════════════════════════════════════ *@
@* MARKUP *@
@* ════════════════════════════════════════════════════════════════ *@

@if (_loading) {
    <h1 class="page-title">
        <i class="fa-solid fa-cubes me-2"></i> NuGet Inventory
    </h1>
    <div class="d-flex align-items-center gap-3 mt-3">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <span class="text-muted">@_loadingMessage</span>
    </div>
} else if (!string.IsNullOrWhiteSpace(_errorMessage)) {
    <h1 class="page-title">
        <i class="fa-solid fa-cubes me-2"></i> NuGet Inventory
    </h1>
    <div class="alert alert-danger mt-3">
        <i class="fa-solid fa-triangle-exclamation me-2"></i> @_errorMessage
    </div>
    <button class="btn btn-primary" @onclick="RefreshInventory">
        <i class="fa-solid fa-rotate me-1"></i> Retry
    </button>
} else if (_inventoryResponse != null) {

    @* ── Header with summary stats ── *@
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <h1 class="page-title mb-0">
            <i class="fa-solid fa-cubes me-2"></i> NuGet Inventory
        </h1>
        <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshInventory">
            <i class="fa-solid fa-rotate me-1"></i> Rescan
        </button>
    </div>

    @* ── Summary cards (clickable → switch to relevant tab) ── *@
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-2 mb-3">
        <div class="col">
            <div class="card text-center h-100" style="cursor: pointer;" @onclick='() => SetActiveTab("projects")' title="View Projects tab">
                <div class="card-body py-2">
                    <div class="fs-4 fw-bold text-primary">@_inventoryResponse.Summary.ProjectCount</div>
                    <small class="text-muted">Projects</small>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card text-center h-100" style="cursor: pointer;" @onclick='() => SetActiveTab("projects")' title="View Projects tab">
                <div class="card-body py-2">
                    <div class="fs-4 fw-bold text-info">@_inventoryResponse.Summary.RepoCount</div>
                    <small class="text-muted">Repos</small>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card text-center h-100" style="cursor: pointer;" @onclick='() => SetActiveTab("frameworks")' title="View Frameworks tab">
                <div class="card-body py-2">
                    <div class="fs-4 fw-bold text-secondary">@_inventoryResponse.Summary.CsprojCount</div>
                    <small class="text-muted">.csproj Files</small>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card text-center h-100" style="cursor: pointer;" @onclick='() => SetActiveTab("packages")' title="View Packages tab">
                <div class="card-body py-2">
                    <div class="fs-4 fw-bold text-primary">@_inventoryResponse.Summary.TotalPackageRefs</div>
                    <small class="text-muted">Package Refs</small>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card text-center h-100" style="cursor: pointer;" @onclick='() => SetActiveTab("packages")' title="View Packages tab">
                <div class="card-body py-2">
                    <div class="fs-4 fw-bold text-warning">@_inventoryResponse.Summary.UniquePackageCount</div>
                    <small class="text-muted">Unique Packages</small>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card text-center h-100">
                <div class="card-body py-2">
                    <div class="fs-4 fw-bold text-success">@_inventoryResponse.ElapsedSeconds.ToString("F1")s</div>
                    <small class="text-muted">Scan Time</small>
                </div>
            </div>
        </div>
    </div>

    @* ── Search and filter bar ── *@
    <div class="d-flex flex-wrap gap-2 mb-2 align-items-center">
        <div class="input-group" style="max-width: 350px;">
            <span class="input-group-text"><i class="fa-solid fa-search"></i></span>
            <input type="text" class="form-control" placeholder="Search packages, versions, projects..."
                   @bind="_searchTerm" @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(_searchTerm)) {
                <button class="btn btn-outline-secondary" @onclick="() => _searchTerm = string.Empty">
                    <i class="fa-solid fa-times"></i>
                </button>
            }
        </div>

        @if (_inventoryResponse.Summary.TargetFrameworks.Count > 0) {
            <select class="form-select" style="max-width: 220px;" @bind="_selectedFramework">
                <option value="">All Frameworks</option>
                @foreach (var fw in _inventoryResponse.Summary.TargetFrameworks) {
                    <option value="@fw">@fw (@GetFrameworkCsprojCount(fw))</option>
                }
            </select>
        }

        <div class="form-check ms-2">
            <input class="form-check-input" type="checkbox" id="multiVersionOnly" @bind="_multiVersionOnly" />
            <label class="form-check-label" for="multiVersionOnly">
                <span class="badge bg-warning text-dark">Version conflicts only</span>
            </label>
        </div>
    </div>

    @* ── Results count indicator ── *@
    @if (!string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_selectedFramework) || _multiVersionOnly) {
        <div class="text-muted small mb-2">
            <i class="fa-solid fa-filter me-1"></i>
            @if (_activeTab == "packages") {
                <span>Showing @FilteredPackages.Count of @TotalPackageCount packages</span>
            } else if (_activeTab == "projects") {
                <span>Showing @FilteredProjects.Count of @TotalProjectCount projects</span>
            } else {
                <span>Showing @FrameworkGroups.Count of @TotalFrameworkCount frameworks</span>
            }
            <button class="btn btn-link btn-sm p-0 ms-2" @onclick="() => { _searchTerm = string.Empty; _selectedFramework = string.Empty; _multiVersionOnly = false; }">
                <i class="fa-solid fa-times me-1"></i>Clear filters
            </button>
        </div>
    }

    @* ── Tab navigation ── *@
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "packages" ? "active" : "")" @onclick='() => SetActiveTab("packages")'>
                <i class="fa-solid fa-box me-1"></i> Packages (@FilteredPackages.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "projects" ? "active" : "")" @onclick='() => SetActiveTab("projects")'>
                <i class="fa-solid fa-folder-tree me-1"></i> Projects (@FilteredProjects.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "frameworks" ? "active" : "")" @onclick='() => SetActiveTab("frameworks")'>
                <i class="fa-solid fa-layer-group me-1"></i> Frameworks (@FrameworkGroups.Count)
            </button>
        </li>
    </ul>

    @* ══════════════════════════════════════════════════════════ *@
    @* TAB: Package Summary (sortable, expandable drill-down) *@
    @* ══════════════════════════════════════════════════════════ *@
    @if (_activeTab == "packages") {
        <div class="table-responsive">
            <table class="table table-sm">
                <thead class="table-light">
                    <tr>
                        <th style="cursor: pointer; user-select: none;" @onclick='() => SortPackages("name")'>
                            Package <i class="fa-solid @GetSortIcon("name") ms-1 text-muted" style="font-size: 0.75em;"></i>
                        </th>
                        <th style="cursor: pointer; user-select: none;" @onclick='() => SortPackages("versions")'>
                            Version(s) <i class="fa-solid @GetSortIcon("versions") ms-1 text-muted" style="font-size: 0.75em;"></i>
                        </th>
                        <th class="text-end" style="width: 80px; cursor: pointer; user-select: none;" @onclick='() => SortPackages("uses")'>
                            Uses <i class="fa-solid @GetSortIcon("uses") ms-1 text-muted" style="font-size: 0.75em;"></i>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pkg in FilteredPackages) {
                        var isExpanded = _expandedPackages.Contains(pkg.Name);
                        <tr style="cursor: pointer;" @onclick="() => TogglePackage(pkg.Name)" class="@(isExpanded ? "table-active" : "")">
                            <td>
                                <i class="fa-solid @(isExpanded ? "fa-chevron-down" : "fa-chevron-right") me-1 text-muted" style="width: 14px; font-size: 0.75em;"></i>
                                @if (pkg.HasMultipleVersions) {
                                    <i class="fa-solid fa-triangle-exclamation text-warning me-1" title="Multiple versions detected"></i>
                                }
                                <span class="@(pkg.HasMultipleVersions ? "fw-bold" : "")">@pkg.Name</span>
                                <a href="https://www.nuget.org/packages/@pkg.Name" target="_blank" rel="noopener" class="ms-1 text-muted"
                                   @onclick:stopPropagation="true" title="View on NuGet.org">
                                    <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 0.7em;"></i>
                                </a>
                            </td>
                            <td>
                                @foreach (var version in pkg.Versions) {
                                    <span class="badge @(pkg.HasMultipleVersions ? "bg-danger" : "bg-success") me-1">@version</span>
                                }
                            </td>
                            <td class="text-end text-muted">@pkg.UsageCount</td>
                        </tr>
                        @if (isExpanded) {
                            var usages = GetPackageUsages(pkg.Name);
                            <tr>
                                <td colspan="3" class="p-0">
                                    <div class="bg-light border-top px-3 py-2">
                                        <div class="small fw-semibold text-muted mb-1">
                                            <i class="fa-solid fa-location-dot me-1"></i>
                                            Used in @usages.Count location@(usages.Count != 1 ? "s" : ""):
                                        </div>
                                        <table class="table table-sm table-borderless mb-0 small">
                                            <thead>
                                                <tr class="text-muted">
                                                    <th style="width: 160px;">Project</th>
                                                    <th style="width: 160px;">Repo</th>
                                                    <th style="width: 120px;">Branch</th>
                                                    <th>.csproj</th>
                                                    <th style="width: 100px;">Version</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var u in usages) {
                                                    var versionClass = pkg.HasMultipleVersions ? "bg-danger" : "bg-success";
                                                    <tr>
                                                        <td class="text-muted">
                                                            <i class="fa-solid fa-folder text-warning me-1" style="font-size: 0.8em;"></i>@u.Project
                                                        </td>
                                                        <td class="text-muted">
                                                            <i class="fa-solid fa-code-branch text-info me-1" style="font-size: 0.8em;"></i>@u.Repo
                                                        </td>
                                                        <td class="text-muted">
                                                            <i class="fa-solid fa-code-fork me-1" style="font-size: 0.8em;"></i>@u.Branch
                                                        </td>
                                                        <td>
                                                            <i class="fa-regular fa-file-code me-1 text-secondary" style="font-size: 0.8em;"></i>
                                                            @u.CsprojPath
                                                            @if (!string.IsNullOrEmpty(u.Framework)) {
                                                                <span class="badge bg-secondary ms-1" style="font-size: 0.65em;">@u.Framework</span>
                                                            }
                                                        </td>
                                                        <td><span class="badge @versionClass" style="font-size: 0.8em;">@u.Version</span></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (FilteredPackages.Count == 0) {
            <div class="text-muted text-center py-4">
                <i class="fa-solid fa-box-open fa-2x mb-2 d-block"></i>
                No packages match the current filters.
            </div>
        }
    }

    @* ══════════════════════════════════════════════════════════ *@
    @* TAB: Project Tree (branch + csproj toggles) *@
    @* ══════════════════════════════════════════════════════════ *@
    @if (_activeTab == "projects") {
        <div class="mb-2">
            <button class="btn btn-outline-secondary btn-sm me-1" @onclick="ExpandAll">
                <i class="fa-solid fa-expand me-1"></i> Expand All
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="CollapseAll">
                <i class="fa-solid fa-compress me-1"></i> Collapse All
            </button>
        </div>

        @foreach (var project in FilteredProjects) {
            var isProjectExpanded = _expandedProjects.Contains(project.Id);
            var projCsprojCount = project.Repos.Sum(r => r.Branches.Sum(b => b.CsprojFiles.Count));
            var projPackageCount = project.Repos.SelectMany(r => r.Branches).SelectMany(b => b.CsprojFiles).SelectMany(c => c.Packages).Count();

            <div class="card mb-2">
                <div class="card-header py-2 d-flex justify-content-between align-items-center" style="cursor: pointer;" @onclick="() => ToggleProject(project.Id)">
                    <div>
                        <i class="fa-solid @(isProjectExpanded ? "fa-chevron-down" : "fa-chevron-right") me-2 text-muted" style="width: 16px;"></i>
                        <i class="fa-solid fa-folder text-warning me-1"></i>
                        <strong>@project.Name</strong>
                        <span class="text-muted ms-2">
                            @project.Repos.Count repo@(project.Repos.Count != 1 ? "s" : ""),
                            @projCsprojCount .csproj,
                            @projPackageCount pkg ref@(projPackageCount != 1 ? "s" : "")
                        </span>
                    </div>
                </div>

                @if (isProjectExpanded) {
                    <div class="card-body py-2 ps-4">
                        @foreach (var repo in project.Repos.OrderBy(r => r.Name)) {
                            var repoKey = project.Id + "/" + repo.Id;
                            var isRepoExpanded = _expandedRepos.Contains(repoKey);

                            <div class="mb-1">
                                <div style="cursor: pointer;" @onclick="() => ToggleRepo(repoKey)" class="py-1">
                                    <i class="fa-solid @(isRepoExpanded ? "fa-chevron-down" : "fa-chevron-right") me-2 text-muted" style="width: 16px;"></i>
                                    <i class="fa-solid fa-code-branch text-info me-1"></i>
                                    <span class="fw-semibold">@repo.Name</span>
                                    <span class="text-muted ms-1">(@repo.Branches.Count branch@(repo.Branches.Count != 1 ? "es" : ""))</span>
                                </div>

                                @if (isRepoExpanded) {
                                    <div class="ps-4">
                                        @foreach (var branch in repo.Branches.OrderBy(b => b.Name)) {
                                            var branchKey = repoKey + "/" + branch.Name;
                                            var isBranchExpanded = _expandedBranches.Contains(branchKey);
                                            var branchCsprojCount = branch.CsprojFiles.Count;

                                            <div class="mb-1">
                                                <div style="cursor: pointer;" @onclick="() => ToggleBranch(branchKey)" class="py-1">
                                                    <i class="fa-solid @(isBranchExpanded ? "fa-chevron-down" : "fa-chevron-right") me-2 text-muted" style="width: 14px; font-size: 0.85em;"></i>
                                                    <i class="fa-solid fa-code-fork me-1 text-muted"></i>
                                                    <span>@branch.Name</span>
                                                    <span class="text-muted ms-1">(@branchCsprojCount .csproj)</span>
                                                </div>

                                                @if (isBranchExpanded) {
                                                    <div class="ps-4">
                                                        @foreach (var csproj in branch.CsprojFiles.OrderBy(c => c.Path)) {
                                                            var csprojKey = branchKey + "/" + csproj.Path;
                                                            var isCsprojExpanded = _expandedCsproj.Contains(csprojKey);

                                                            <div class="mb-1">
                                                                <div style="cursor: pointer;" @onclick="() => ToggleCsproj(csprojKey)" class="py-1">
                                                                    <i class="fa-solid @(isCsprojExpanded ? "fa-chevron-down" : "fa-chevron-right") me-2 text-muted" style="width: 14px; font-size: 0.8em;"></i>
                                                                    <i class="fa-regular fa-file-code me-1 text-secondary"></i>
                                                                    <span>@csproj.Path</span>
                                                                    @if (!string.IsNullOrEmpty(csproj.TargetFramework)) {
                                                                        <span class="badge bg-secondary ms-1">@csproj.TargetFramework</span>
                                                                    }
                                                                    @if (csproj.Packages.Count > 0) {
                                                                        <span class="text-muted ms-1">(@csproj.Packages.Count pkg@(csproj.Packages.Count != 1 ? "s" : ""))</span>
                                                                    }
                                                                </div>

                                                                @if (isCsprojExpanded && csproj.Packages.Count > 0) {
                                                                    <div class="ps-4 pb-1">
                                                                        @foreach (var pkg in csproj.Packages.OrderBy(p => p.Name)) {
                                                                            var isConflict = _inventoryResponse?.PackageSummary?.Any(ps =>
                                                                                string.Equals(ps.Name, pkg.Name, StringComparison.OrdinalIgnoreCase) && ps.HasMultipleVersions) == true;
                                                                            <div class="small">
                                                                                @if (isConflict) {
                                                                                    <i class="fa-solid fa-triangle-exclamation text-warning me-1" style="font-size: 0.8em;" title="Version conflict across org"></i>
                                                                                }
                                                                                <span class="@(isConflict ? "fw-semibold" : "text-muted")">@pkg.Name</span>
                                                                                <span class="badge @(isConflict ? "bg-danger" : "bg-success") ms-1" style="font-size: 0.7em;">@pkg.Version</span>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (FilteredProjects.Count == 0) {
            <div class="text-muted text-center py-4">
                <i class="fa-solid fa-folder-open fa-2x mb-2 d-block"></i>
                No projects match the current filters.
            </div>
        }
    }

    @* ══════════════════════════════════════════════════════════ *@
    @* TAB: Framework Summary (collapsible, filtered) *@
    @* ══════════════════════════════════════════════════════════ *@
    @if (_activeTab == "frameworks") {
        @foreach (var fwGroup in FrameworkGroups) {
            var isFrameworkExpanded = _expandedFrameworks.Contains(fwGroup.Key);
            var fwCount = fwGroup.Count();
            <div class="card mb-2">
                <div class="card-header py-2 d-flex justify-content-between align-items-center" style="cursor: pointer;" @onclick="() => ToggleFramework(fwGroup.Key)">
                    <div>
                        <i class="fa-solid @(isFrameworkExpanded ? "fa-chevron-down" : "fa-chevron-right") me-2 text-muted" style="width: 16px;"></i>
                        <span class="badge bg-secondary me-2">@fwGroup.Key</span>
                        <span class="text-muted">@fwCount .csproj file@(fwCount != 1 ? "s" : "")</span>
                    </div>
                </div>
                @if (isFrameworkExpanded) {
                    <div class="card-body py-2">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 200px;">Project</th>
                                        <th style="width: 200px;">Repo</th>
                                        <th>.csproj Path</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in fwGroup.OrderBy(x => x.Project).ThenBy(x => x.Repo)) {
                                        <tr>
                                            <td>
                                                <i class="fa-solid fa-folder text-warning me-1" style="font-size: 0.85em;"></i>
                                                <span class="text-muted">@item.Project</span>
                                            </td>
                                            <td>
                                                <i class="fa-solid fa-code-branch text-info me-1" style="font-size: 0.85em;"></i>
                                                <span class="text-muted">@item.Repo</span>
                                            </td>
                                            <td>
                                                <i class="fa-regular fa-file-code me-1 text-secondary" style="font-size: 0.85em;"></i>
                                                @item.Csproj
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }

        @if (FrameworkGroups.Count == 0) {
            <div class="text-muted text-center py-4">
                <i class="fa-solid fa-layer-group fa-2x mb-2 d-block"></i>
                No framework data matches the current filters.
            </div>
        }
    }

    @* ── Footer with scan time ── *@
    @if (_inventoryResponse.LastScannedUtc.HasValue) {
        <div class="text-muted small mt-3">
            <i class="fa-regular fa-clock me-1"></i>
            Last scanned: @_inventoryResponse.LastScannedUtc.Value.ToLocalTime().ToString("g")
            — @_inventoryResponse.ElapsedSeconds.ToString("F1")s
        </div>
    }
}
