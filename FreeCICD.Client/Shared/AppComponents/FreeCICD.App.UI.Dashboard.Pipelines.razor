@* Pipeline Dashboard Component *@
@* Displays a list of Azure DevOps pipelines with filtering, sorting, grouping, and Card/Table views *@

@using Humanizer
@inherits AppLoadingPageBase

@code {
    protected override string PageName => AppViews.Pipelines;
    protected override Task LoadAsync() => LoadDashboardData();
    protected override string InitialLoadingMessage => "Loading pipelines...";

    protected DataObjects.PipelineDashboardResponse? _dashboardResponse;

    // Filter state (one value from the filter bar; the search term is not saved with the preferences)
    protected DashboardView.FilterState _filters = new();

    // Health trends state
    protected DataObjects.OrgHealthResponse? _healthData;
    protected bool _healthLoading = false;
    protected bool _healthExpanded = false;

    // View state, saved with the preferences
    protected string _viewMode = "table";
    protected bool _groupByFolder = false;
    protected string _sortBy = DashboardView.DefaultSortKey; // a DashboardView.Sorts key

    // The full paths of the expanded folders
    protected HashSet<string> _expandedGroups = [];

    // What the markup shows, computed by Recompute() when the data, filters, sort or grouping change.
    // Rendering only reads these, so a render does no filtering, sorting or counting.
    protected List<DataObjects.PipelineListItem> _filtered = [];
    protected List<FolderNode> _rootFolders = [];
    protected List<string> _repositories = [];
    protected DashboardView.StatusCounts _footerCounts = new();

    // Pipeline id -> index in _dashboardResponse.Pipelines, so batch and live updates find their item directly.
    protected Dictionary<int, int> _indexById = [];

    // Folder node model for recursive hierarchy
    public class FolderNode
    {
        public DashboardView.StatusCounts Counts { get; set; } = new();
        public int Depth { get; set; } = 0;
        public string FullPath { get; set; } = "";
        public string GroupId { get; set; } = "";
        public string Name { get; set; } = "";
        public List<DataObjects.PipelineListItem> Pipelines { get; set; } = [];
        public List<FolderNode> SubFolders { get; set; } = [];

        // Totals including subfolders, filled bottom-up once when the hierarchy is built.
        public int TotalCount { get; set; }
    }

    /// <summary>Recomputes everything the markup reads. Call after changing the data, filters, sort or grouping.</summary>
    protected void Recompute()
    {
        _filtered = FilterAndSort(_dashboardResponse?.Pipelines ?? []);
        _rootFolders = _groupByFolder ? BuildFolderHierarchy(_filtered) : [];
        _footerCounts = DashboardView.StatusCounts.Of(_filtered);
    }

    /// <summary>The id index and the repository list, which change only with the data, never with a filter.</summary>
    protected void RebuildIndex()
    {
        _indexById = [];
        var all = _dashboardResponse?.Pipelines ?? [];
        for (int i = 0; i < all.Count; i++) {
            _indexById[all[i].Id] = i;
        }
        RebuildRepositories();
    }

    protected void RebuildRepositories()
    {
        _repositories = (_dashboardResponse?.Pipelines ?? []).Select(DashboardView.DisplayRepoName)
            .Where(r => !string.IsNullOrWhiteSpace(r))
            .Distinct()
            .OrderBy(r => r)
            .ToList();
    }

    protected List<DataObjects.PipelineListItem> FilterAndSort(List<DataObjects.PipelineListItem> all)
    {
        var pipelines = all.AsEnumerable();
        var f = _filters;
        bool Same(string? a, string b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

        if (!string.IsNullOrWhiteSpace(f.SearchTerm)) {
            var search = f.SearchTerm.Trim();
            bool Has(string? value) => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;
            pipelines = pipelines.Where(p => Has(p.Name) || Has(p.CodeRepoName) || Has(p.RepositoryName) || Has(p.Path));
        }

        if (!string.IsNullOrWhiteSpace(f.Status)) {
            pipelines = pipelines.Where(p => Same(p.LastRunStatus, f.Status));
        }

        if (!string.IsNullOrWhiteSpace(f.Result)) {
            pipelines = pipelines.Where(p => Same(p.LastRunResult, f.Result));
        }

        if (!string.IsNullOrWhiteSpace(f.Repository)) {
            pipelines = pipelines.Where(p => DashboardView.DisplayRepoName(p) == f.Repository);
        }

        if (!string.IsNullOrWhiteSpace(f.Trigger)) {
            pipelines = f.Trigger.ToLower() switch {
                "manual" => pipelines.Where(p => p.TriggerType == DataObjects.TriggerType.Manual),
                "codepush" => pipelines.Where(p => p.TriggerType == DataObjects.TriggerType.CodePush),
                "scheduled" => pipelines.Where(p => p.TriggerType == DataObjects.TriggerType.Scheduled),
                "pullrequest" => pipelines.Where(p => p.TriggerType == DataObjects.TriggerType.PullRequest),
                "pipelinecompletion" => pipelines.Where(p => p.TriggerType == DataObjects.TriggerType.PipelineCompletion),
                "other" => pipelines.Where(p => p.TriggerType == DataObjects.TriggerType.Other ||
                                                p.TriggerType == DataObjects.TriggerType.ResourceTrigger),
                _ => pipelines
            };
        }

        if (f.FailedOnly) {
            pipelines = pipelines.Where(p => Same(p.LastRunResult, "failed"));
        }

        return DashboardView.Sort(_sortBy).Apply(pipelines).ToList();
    }

    protected List<FolderNode> BuildFolderHierarchy(List<DataObjects.PipelineListItem> pipelines)
    {
        var rootNodes = new Dictionary<string, FolderNode>();
        FolderNode NewNode(string name, string fullPath, int depth) => new FolderNode {
            Name = name,
            FullPath = fullPath,
            GroupId = fullPath.Replace(" ", "-").Replace("/", "-").ToLower(),
            Depth = depth
        };

        foreach (var pipeline in pipelines) {
            var path = pipeline.Path?.TrimStart('\\', '/') ?? "";
            var segments = path.Split(['\\', '/'], StringSplitOptions.RemoveEmptyEntries);

            if (segments.Length == 0) {
                // Pipeline is at root level - use "Uncategorized"
                if (!rootNodes.TryGetValue("Uncategorized", out var uncatNode)) {
                    uncatNode = NewNode("Uncategorized", "Uncategorized", 0);
                    rootNodes["Uncategorized"] = uncatNode;
                }
                uncatNode.Pipelines.Add(pipeline);
            } else {
                // Navigate/create folder hierarchy
                var rootName = segments[0];
                if (!rootNodes.TryGetValue(rootName, out var currentNode)) {
                    currentNode = NewNode(rootName, rootName, 0);
                    rootNodes[rootName] = currentNode;
                }

                // Navigate through remaining segments
                for (int i = 1; i < segments.Length; i++) {
                    var segmentName = segments[i];
                    var childNode = currentNode.SubFolders.FirstOrDefault(s => s.Name == segmentName);
                    if (childNode == null) {
                        childNode = NewNode(segmentName, string.Join("/", segments.Take(i + 1)), i);
                        currentNode.SubFolders.Add(childNode);
                    }
                    currentNode = childNode;
                }

                // Add pipeline to the deepest folder
                currentNode.Pipelines.Add(pipeline);
            }
        }

        var result = rootNodes.Values.OrderBy(f => f.Name).ToList();
        SortAndCountFolders(result);
        return result;
    }

    // Folders are sorted by name; pipelines keep the order of the list they came from (the chosen sort).
    // Counts are summed bottom-up here so rendering a folder does not walk its subtree.
    protected void SortAndCountFolders(List<FolderNode> folders)
    {
        foreach (var folder in folders) {
            folder.SubFolders = folder.SubFolders.OrderBy(s => s.Name).ToList();
            SortAndCountFolders(folder.SubFolders);

            folder.Counts = DashboardView.StatusCounts.Of(folder.Pipelines);
            folder.TotalCount = folder.Pipelines.Count;
            foreach (var sub in folder.SubFolders) {
                folder.Counts.Add(sub.Counts);
                folder.TotalCount += sub.TotalCount;
            }
        }
    }

    // Progressive loading state
    protected int _loadedCount = 0;
    protected int _totalCount = 0;
    protected bool _isProgressiveLoading = false;
    protected string _loadingDetail = "";

    // Auto-refresh (live monitoring) state
    protected bool _autoRefresh = false;
    protected bool _autoRefreshJoining = false;
    protected int _liveSwitchKey = 0; // bumped to re-create the switch when a toggle is refused without a render in between
    protected DashboardView.LiveMonitorState _live = new();

    /// <summary>The live monitor's SignalR group, joined while live updates are on.</summary>
    protected readonly SignalRGroupMembership _monitor = new(DataObjects.Endpoints.PipelineDashboard.MonitorJoin, DataObjects.Endpoints.PipelineDashboard.MonitorLeave);
    protected bool _monitorRejoining = false;

    public override void Dispose()
    {
        base.Dispose();

        // Leave the live monitor group if it was joined (a no-op otherwise).
        _autoRefresh = false;
        _ = _monitor.LeaveAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) {
            await LoadPreferences();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    /// <summary>
    /// The progressive load (skeleton, enriched batches, progress text, done) and the live monitor's updates.
    /// </summary>
    protected override void OnSignalRUpdate(DataObjects.SignalRUpdate update)
    {
        if (update == null) return;

        // Ignore updates addressed to another connection (another browser's progressive load).
        // Updates without a connection id (the live monitor's) are for every page.
        string connectionId = Helpers.CurrentConnectionId();
        if (!string.IsNullOrWhiteSpace(update.ConnectionId) && !string.IsNullOrWhiteSpace(connectionId) && update.ConnectionId != connectionId) return;

        switch (update.UpdateType) {
            case DataObjects.SignalRUpdateType.DashboardPipelinesSkeleton:
                HandleSkeletonUpdate(update);
                break;

            case DataObjects.SignalRUpdateType.DashboardPipelineBatch:
                HandleBatchUpdate(update);
                break;

            case DataObjects.SignalRUpdateType.DashboardLoadComplete:
                _isProgressiveLoading = false;
                _loading = false;
                _loadingMessage = "";
                _loadingDetail = "";
                InvokeAsync(StateHasChanged);
                break;

            case DataObjects.SignalRUpdateType.LoadingDevOpsInfoStatusUpdate:
                // The pipeline being loaded right now
                if (!string.IsNullOrWhiteSpace(update.Message)) {
                    _loadingDetail = update.Message;
                    InvokeAsync(StateHasChanged);
                }
                break;

            case DataObjects.SignalRUpdateType.PipelineLiveStatusUpdate:
                HandleLiveStatusUpdate(update);
                break;
        }
    }

    /// <summary>
    /// Handles skeleton update - shows pipeline cards with minimal info.
    /// </summary>
    private void HandleSkeletonUpdate(DataObjects.SignalRUpdate update)
    {
        var skeletonItems = Helpers.SignalRPayload<List<DataObjects.PipelineListItem>>(update);
        if (skeletonItems == null) return;

        _dashboardResponse ??= new DataObjects.PipelineDashboardResponse();

        // Handle "connecting" state (empty list) vs actual skeleton
        if (skeletonItems.Count == 0) {
            // First signal - just show we're connecting
            _isProgressiveLoading = true;
            _loading = false;
            _loadingMessage = update.Message ?? "Connecting to Azure DevOps...";
            _totalCount = 0;
            _loadedCount = 0;
        } else {
            // Actual skeleton with pipeline names
            _dashboardResponse.Pipelines = skeletonItems;
            _dashboardResponse.TotalCount = skeletonItems.Count;
            _totalCount = skeletonItems.Count;
            _loadedCount = 0;
            _isProgressiveLoading = true;
            _loading = false;
            _loadingMessage = update.Message ?? $"Found {skeletonItems.Count} pipelines";
            RebuildIndex();
            InitializeExpandedGroups();
            Recompute();
        }
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Handles batch update - updates existing pipeline items with enriched data.
    /// </summary>
    private void HandleBatchUpdate(DataObjects.SignalRUpdate update)
    {
        var batchItems = Helpers.SignalRPayload<List<DataObjects.PipelineListItem>>(update);
        if (batchItems == null || _dashboardResponse?.Pipelines == null) return;

        foreach (var enrichedItem in batchItems) {
            if (_indexById.TryGetValue(enrichedItem.Id, out var index)) {
                _dashboardResponse.Pipelines[index] = enrichedItem;
            }
        }
        _loadedCount += batchItems.Count;

        // Parse message — format is "Loaded X of Y pipelines|Name1, Name2, Name3"
        var msg = update.Message ?? "";
        var pipeIndex = msg.IndexOf('|');
        if (pipeIndex > 0) {
            _loadingMessage = msg[..pipeIndex];
            _loadingDetail = msg[(pipeIndex + 1)..];
        } else {
            _loadingMessage = !string.IsNullOrWhiteSpace(msg) ? msg : $"Loaded {_loadedCount} of {_totalCount} pipelines";
        }
        // An enriched item can name the code repository the skeleton did not have.
        RebuildRepositories();
        Recompute();
        InvokeAsync(StateHasChanged);
    }

    protected override void OnDataModelUpdated()
    {
        base.OnDataModelUpdated();

        // A SignalR reconnect that could not resume gets a new connection id and no groups. If live updates are
        // on, join the monitor group again with the new id, or the switch stays on while nothing arrives.
        // A refused re-join leaves the membership empty, so it is not retried on every model change.
        if (_autoRefresh && !_autoRefreshJoining && !_monitorRejoining && _monitor.JoinedConnectionId.Length > 0
            && Helpers.CurrentConnectionId().Length > 0 && !_monitor.IsJoined) {
            _monitorRejoining = true;
            _ = InvokeAsync(async () => {
                try {
                    await _monitor.EnsureJoinedAsync();
                } finally {
                    _monitorRejoining = false;
                }
            });
        }
    }

    /// <summary>
    /// Handles live status updates from the background pipeline monitor service.
    /// Called on every poll cycle — even when nothing changed (heartbeat). The heartbeat only re-renders the
    /// live indicators; the dashboard re-renders when a pipeline actually changed.
    /// </summary>
    private void HandleLiveStatusUpdate(DataObjects.SignalRUpdate update)
    {
        var liveUpdate = Helpers.SignalRPayload<DataObjects.PipelineLiveUpdate>(update);
        if (liveUpdate == null) return;

        _live.LastCheck = liveUpdate.Timestamp;
        _live.PipelinesChecked = liveUpdate.PipelinesChecked;
        _live.RunningCount = liveUpdate.RunningCount;

        bool anyChanged = false;
        if (liveUpdate.ChangedPipelines?.Count > 0 && _dashboardResponse?.Pipelines != null) {
            foreach (var changed in liveUpdate.ChangedPipelines) {
                if (!_indexById.TryGetValue(changed.Id, out var index)) continue;

                // Every field of the new build, including its trigger, links and duration (null while it runs).
                changed.ApplyTo(_dashboardResponse.Pipelines[index]);
                anyChanged = true;
            }
        }

        if (anyChanged) {
            _live.LastUpdate = liveUpdate.Timestamp;
            _live.ChangedCount = liveUpdate.ChangedPipelines!.Count;
            Recompute();
            InvokeAsync(StateHasChanged);
        }
        _live.Notify();
    }

    /// <summary>
    /// Toggles auto-refresh on/off. Joins or leaves the PipelineMonitor SignalR group.
    /// </summary>
    protected async Task ToggleAutoRefresh()
    {
        if (Helpers.CurrentConnectionId().Length == 0) {
            // Without a connection the server cannot send updates, so the switch stays off.
            _liveSwitchKey++;
            Model.AddMessage("Live updates need the real-time connection, which is not connected yet. Try again in a moment.", MessageType.Warning);
            StateHasChanged();
            return;
        }

        _autoRefresh = !_autoRefresh;
        _autoRefreshJoining = true;
        StateHasChanged();

        if (_autoRefresh) {
            if (!await _monitor.EnsureJoinedAsync()) {
                _autoRefresh = false;
                Model.AddMessage(string.IsNullOrWhiteSpace(_monitor.LastError) ? "Could not change live updates. Please try again." : _monitor.LastError, MessageType.Danger);
            }
        } else {
            // Leaving is best effort (the hub drops the group with the connection), so turning off always succeeds.
            await _monitor.LeaveAsync();
            _live.Reset();
        }

        _autoRefreshJoining = false;
        StateHasChanged();
    }

    protected Task LoadDashboardData() => RunLoadAsync("Loading pipelines...", "Error loading pipelines", async () => {
        var response = await Helpers.GetOrPost<DataObjects.PipelineDashboardResponse>(
            DataObjects.Endpoints.PipelineDashboard.GetPipelinesList + Helpers.ConnectionIdQuery());

        if (response != null) {
            _dashboardResponse = response;
            if (!response.Success && !string.IsNullOrWhiteSpace(response.ErrorMessage)) {
                _errorMessage = response.ErrorMessage;
            }
            RebuildIndex();
            InitializeExpandedGroups();
            Recompute();

            // Rows that could not be filled in completely are still listed; say once what is missing and why.
            if (response.Warnings.Count > 0) {
                Model.AddMessage(String.Join("<br />", response.Warnings.Select(System.Net.WebUtility.HtmlEncode)), MessageType.Warning, AutoHide: false);
            }
        } else {
            Model.UnknownError();
        }
    });

    /// <summary>
    /// Expands every folder of the whole list, not only those passing the current filter, so clearing a filter
    /// does not reveal collapsed folders. The paths are the ones BuildFolderHierarchy gives its folders.
    /// </summary>
    protected void InitializeExpandedGroups()
    {
        _expandedGroups.Clear();
        foreach (var pipeline in _dashboardResponse?.Pipelines ?? []) {
            var segments = (pipeline.Path ?? "").Split(['\\', '/'], StringSplitOptions.RemoveEmptyEntries);
            if (segments.Length == 0) {
                _expandedGroups.Add("Uncategorized");
                continue;
            }
            _expandedGroups.Add(segments[0]);
            for (int i = 1; i < segments.Length; i++) {
                _expandedGroups.Add(string.Join("/", segments.Take(i + 1)));
            }
        }
    }

    protected async Task RefreshDashboard()
    {
        _isProgressiveLoading = false;
        _loadedCount = 0;
        _totalCount = 0;
        _loadingMessage = "Loading pipelines...";
        _loadingDetail = "";
        await LoadDashboardData();
    }

    protected void NavigateToWizard()
    {
        Helpers.NavigateTo("Wizard");
    }

    /// <summary>
    /// Copies pipeline YAML to clipboard.
    /// </summary>
    protected async Task OnCopyYaml(DataObjects.PipelineListItem pipeline)
    {
        var response = await Helpers.GetOrPost<DataObjects.PipelineYamlResponse>(
            DataObjects.Endpoints.PipelineDashboard.GetPipelineYaml.Replace("{id}", pipeline.Id.ToString()));

        if (response?.Success == true && !string.IsNullOrWhiteSpace(response.Yaml)) {
            await Helpers.CopyToClipboard(response.Yaml);
            Model.AddMessage($"YAML for '{pipeline.Name}' copied to clipboard!", MessageType.Success);
        } else if (response == null) {
            Model.UnknownError();
        } else {
            Model.ErrorMessage(response.ErrorMessage ?? "The pipeline has no YAML content.");
        }
    }

    /// <summary>
    /// Loads org-wide health trends (lazy, user-triggered). A failed load is retried the next time the panel opens.
    /// </summary>
    protected async Task ToggleHealthPanel()
    {
        _healthExpanded = !_healthExpanded;

        if (_healthExpanded && _healthData?.Success != true) {
            _healthLoading = true;
            StateHasChanged();

            _healthData = await Helpers.GetOrPost<DataObjects.OrgHealthResponse>(DataObjects.Endpoints.PipelineDashboard.GetHealth + "?top=10");
            if (_healthData?.Success != true && string.IsNullOrWhiteSpace(_healthData?.ErrorMessage)) {
                _healthData = new DataObjects.OrgHealthResponse { ErrorMessage = "Failed to load health data." };
            }

            _healthLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Triggers a manual run of a pipeline via the Azure DevOps API.
    /// </summary>
    protected async Task OnRunPipeline(DataObjects.PipelineListItem pipeline)
    {
        var response = await Helpers.GetOrPost<DataObjects.BooleanResponse>(
            DataObjects.Endpoints.PipelineDashboard.RunPipeline.Replace("{pipelineId}", pipeline.Id.ToString()), new { }, true);

        if (response?.Result == true) {
            Model.AddMessage(response.Messages.FirstOrDefault() ?? $"Pipeline '{pipeline.Name}' queued successfully!", MessageType.Success);
        } else if (response == null) {
            Model.UnknownError();
        } else {
            Model.ErrorMessages(response.Messages);
        }
    }

    // Filter/Sort/View handlers
    protected void OnFiltersChanged(DashboardView.FilterState filters)
    {
        // The search term is not part of the saved preferences, so typing does not write to localStorage.
        bool saved = filters with { SearchTerm = "" } != _filters with { SearchTerm = "" };
        _filters = filters;
        Recompute();
        if (saved) {
            _ = SavePreferences();
        }
    }

    protected void OnViewModeChanged(string mode)
    {
        _viewMode = mode;
        _ = SavePreferences();
    }

    protected void OnGroupByFolderChanged(bool groupBy)
    {
        _groupByFolder = groupBy;
        if (groupBy) {
            InitializeExpandedGroups();
        }
        Recompute();
        _ = SavePreferences();
    }

    protected void OnSortByChanged(string sortBy)
    {
        _sortBy = sortBy;
        Recompute();
        _ = SavePreferences();
    }

    // A table header click: the sort for that column and direction, if the column has one.
    protected void OnTableSortChanged((string Column, bool Ascending) sort)
    {
        _sortBy = DashboardView.SortForHeader(sort.Column, sort.Ascending)?.Key ?? _sortBy;
        Recompute();
        _ = SavePreferences();
    }

    protected void OnExpandAll()
    {
        InitializeExpandedGroups();
    }

    protected void OnCollapseAll()
    {
        _expandedGroups.Clear();
    }

    protected void OnGroupExpandedChanged(string groupName, bool isExpanded)
    {
        if (isExpanded) {
            _expandedGroups.Add(groupName);
        } else {
            _expandedGroups.Remove(groupName);
        }
    }

    // localStorage persistence
    // Older versions wrote the preferences as raw JSON text; reading the item as a string returns that text as is,
    // and also unwraps the string this version stores. Values that cannot be read keep the defaults.
    protected const string PreferencesKey = "pipelineDashboardPrefs";

    protected async Task LoadPreferences()
    {
        var prefs = PipelineDashboardPreferences.Parse(await Helpers.GetLocalStorageItem<string>(PreferencesKey));
        if (prefs == null) return;

        if (prefs.ViewMode == "card" || prefs.ViewMode == "table") { _viewMode = prefs.ViewMode; }
        if (prefs.GroupByFolder.HasValue) { _groupByFolder = prefs.GroupByFolder.Value; }
        if (DashboardView.FindSort(prefs.SortBy) != null) { _sortBy = prefs.SortBy!; }
        _filters = _filters with {
            Status = prefs.Status ?? _filters.Status,
            Result = prefs.Result ?? _filters.Result,
            Repository = prefs.Repository ?? _filters.Repository,
            Trigger = prefs.Trigger ?? _filters.Trigger,
            FailedOnly = prefs.FailedOnly ?? _filters.FailedOnly,
        };
        Recompute();
        StateHasChanged();
    }

    protected async Task SavePreferences()
    {
        try {
            var prefs = new PipelineDashboardPreferences {
                ViewMode = _viewMode,
                GroupByFolder = _groupByFolder,
                SortBy = _sortBy,
                Status = _filters.Status,
                Result = _filters.Result,
                Repository = _filters.Repository,
                Trigger = _filters.Trigger,
                FailedOnly = _filters.FailedOnly
            };
            await Helpers.SetLocalStorageItem(PreferencesKey, Helpers.SerializeObject(prefs));
        } catch {
            // Ignore localStorage errors
        }
    }

    public class PipelineDashboardPreferences
    {
        public bool? FailedOnly { get; set; }
        public bool? GroupByFolder { get; set; }
        public string? Repository { get; set; }
        public string? Result { get; set; }
        public string? SortBy { get; set; }
        public string? Status { get; set; }
        public string? Trigger { get; set; }
        public string? ViewMode { get; set; }

        // Parses the stored text. Returns null when it is missing or not a JSON object; a field that is missing or of
        // the wrong type is null (older stored values only have ViewMode, GroupByFolder and SortBy).
        public static PipelineDashboardPreferences? Parse(string? json)
        {
            if (string.IsNullOrWhiteSpace(json)) { return null; }

            try {
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                var root = doc.RootElement;
                if (root.ValueKind != System.Text.Json.JsonValueKind.Object) { return null; }

                string? Text(string name) => root.TryGetProperty(name, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.String ? v.GetString() : null;
                bool? Flag(string name) => root.TryGetProperty(name, out var v) && (v.ValueKind == System.Text.Json.JsonValueKind.True || v.ValueKind == System.Text.Json.JsonValueKind.False) ? v.GetBoolean() : null;

                return new PipelineDashboardPreferences {
                    ViewMode = Text(nameof(ViewMode)),
                    GroupByFolder = Flag(nameof(GroupByFolder)),
                    SortBy = Text(nameof(SortBy)),
                    Status = Text(nameof(Status)),
                    Result = Text(nameof(Result)),
                    Repository = Text(nameof(Repository)),
                    Trigger = Text(nameof(Trigger)),
                    FailedOnly = Flag(nameof(FailedOnly))
                };
            } catch (System.Text.Json.JsonException) {
                return null;
            }
        }
    }
}

<div class="container-fluid px-0 pipeline-dashboard" style="max-width: 1400px;">
        @* Page Header *@
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="page-title mb-0">
                <Icon Name="Pipelines" /> Pipeline Dashboard
            </h1>
            <div class="d-flex gap-2 align-items-center">
                @* Auto-Refresh Toggle *@
                @if (!_loading && !_isProgressiveLoading && _dashboardResponse?.Pipelines?.Any() == true) {
                    <div class="d-flex align-items-center me-2">
                        <div class="form-check form-switch mb-0" title="@(_autoRefresh ? "Live updates active — polling every 5 seconds" : "Enable live updates to see pipeline status changes in real-time")">
                            <input type="checkbox" role="switch" class="form-check-input"
                                    @key="_liveSwitchKey"
                                    id="autoRefreshToggle"
                                    checked="@_autoRefresh"
                                    disabled="@_autoRefreshJoining"
                                    @onchange="ToggleAutoRefresh" />
                            <label for="autoRefreshToggle" class="form-check-label small @(_autoRefresh ? "text-success" : "text-muted")">
                                @if (_autoRefreshJoining) {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                } else if (_autoRefresh) {
                                    <DashboardLiveIndicator State="_live" Part="dot" />
                                }
                                Live
                            </label>
                        </div>
                        @if (_autoRefresh) {
                            <DashboardLiveIndicator State="_live" Part="running" />
                        }
                    </div>
                }

                <button class="btn btn-outline-secondary" @onclick="RefreshDashboard" disabled="@(_loading || _isProgressiveLoading)">
                    <i class="fa fa-refresh @((_loading || _isProgressiveLoading) ? "fa-spin" : "")"></i>
                    Refresh
                </button>
                <button class="btn btn-primary" @onclick="NavigateToWizard">
                    <i class="fa fa-plus me-1"></i>
                    Create Pipeline
                </button>
            </div>
        </div>

        @* Progressive Loading Banner *@
        @if (_isProgressiveLoading) {
            <div class="alert alert-info d-flex align-items-center mb-3" role="alert">
                <div class="spinner-border spinner-border-sm me-2" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <div class="flex-grow-1">
                    <div>@_loadingMessage</div>
                    @if (!string.IsNullOrWhiteSpace(_loadingDetail)) {
                        <div class="small text-muted mt-0" style="opacity: 0.8;">@_loadingDetail</div>
                    }
                </div>
                @if (_totalCount > 0) {
                    <div class="ms-3">
                        <div class="progress" style="width: 150px; height: 8px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated"
                                    role="progressbar"
                                    style="width: @((_loadedCount * 100 / _totalCount))%"
                                    aria-valuenow="@_loadedCount"
                                    aria-valuemin="0"
                                    aria-valuemax="@_totalCount">
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @* Loading State (only when no progressive updates yet) *@
        @if (_loading && !_isProgressiveLoading) {
            <FreeCICD_App_UI_Loading Message="@_loadingMessage" />
        }
        @* Error State *@
        else if (!string.IsNullOrWhiteSpace(_errorMessage) && !_isProgressiveLoading) {
            <div class="alert alert-danger" role="alert">
                <i class="fa fa-exclamation-triangle me-2"></i>
                @_errorMessage
                <button class="btn btn-sm btn-outline-danger ms-3" @onclick="RefreshDashboard">
                    Try Again
                </button>
            </div>
        }
        @* Content - show when we have pipelines OR during progressive loading with pipelines *@
        @if ((_dashboardResponse?.Pipelines?.Any() == true) || (!_loading && !_isProgressiveLoading && string.IsNullOrWhiteSpace(_errorMessage))) {
            @* Filter Bar *@
            <FreeCICD_App_UI_Dashboard_FilterBar
                    Filters="@_filters"
                    FiltersChanged="@OnFiltersChanged"
                    Repositories="@_repositories" />

            @RenderViewControls()

            @* Empty State (after filtering) *@
            @if (_filtered.Count == 0) {
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center py-5">
                        @if (_dashboardResponse?.Pipelines?.Any() == true) {
                            <i class="fa fa-filter fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">No Matching Pipelines</h4>
                            <p class="text-muted mb-4">Try adjusting your filters or search term.</p>
                        } else {
                            <i class="fa fa-folder-open fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">No Pipelines Found</h4>
                            <p class="text-muted mb-4">Get started by creating your first pipeline.</p>
                            <button class="btn btn-primary btn-lg" @onclick="NavigateToWizard">
                                <i class="fa fa-plus me-2"></i>
                                Create Your First Pipeline
                            </button>
                        }
                    </div>
                </div>
            }
            @* Grouped by folder, nested *@
            else if (_groupByFolder) {
                @foreach (var folder in _rootFolders) {
                    @RenderFolderNode(folder)
                }
            }
            @* Flat View (no grouping) *@
            else {
                @if (_viewMode == "card") {
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
                        @foreach (var pipeline in _filtered) {
                            <div class="col" @key="pipeline.Id">
                                @RenderPipelineCard(pipeline)
                            </div>
                        }
                    </div>
                } else {
                    <div class="card shadow-sm border-0">
                        <div class="card-body p-0">
                            <FreeCICD_App_UI_Dashboard_TableView
                                    Pipelines="@_filtered"
                                    SortColumn="@DashboardView.Sort(_sortBy).Column"
                                    SortAscending="@DashboardView.Sort(_sortBy).Ascending"
                                    OnSortChanged="@OnTableSortChanged"
                                    OnCopyYaml="@OnCopyYaml"
                                    OnRunPipeline="@OnRunPipeline" />
                        </div>
                    </div>
                }
            }

            @* Health Trends Panel (collapsible, non-intrusive) *@
            <div class="mt-3">
                <button class="btn btn-sm @(_healthExpanded ? "btn-outline-primary" : "btn-outline-secondary") d-flex align-items-center gap-1"
                        @onclick="ToggleHealthPanel" title="View organization pipeline health trends">
                    <i class="fa fa-heartbeat me-1"></i>
                    Health Trends
                    <i class="fa @(_healthExpanded ? "fa-chevron-up" : "fa-chevron-down") ms-1" style="font-size: 0.7em;"></i>
                </button>

                @if (_healthExpanded) {
                    @if (_healthLoading) {
                        <div class="mt-2 p-3 text-center text-muted">
                            <i class="fa fa-spinner fa-spin me-2"></i>Loading health data for all pipelines...
                        </div>
                    } else if (_healthData?.Success == true) {
                        <div class="mt-2 card border-0 shadow-sm">
                            <div class="card-body p-3">
                                @* Summary Bar *@
                                <div class="d-flex align-items-center gap-4 mb-3">
                                    <div class="d-flex align-items-center gap-2">
                                        @{
                                            var healthColorClass = _healthData.Summary.OverallHealthPercent >= 80 ? "text-success" : _healthData.Summary.OverallHealthPercent >= 50 ? "text-warning" : "text-danger";
                                        }
                                        <div class="fw-bold @healthColorClass" style="font-size: 1.8em; line-height: 1;">
                                            @(_healthData.Summary.OverallHealthPercent)%
                                        </div>
                                        <div class="small text-muted">
                                            Overall<br/>Health
                                        </div>
                                    </div>
                                    <div class="vr"></div>
                                    <div class="small">
                                        <span class="text-success me-3"><i class="fa fa-check-circle me-1"></i>@_healthData.Summary.HealthyPipelines healthy</span>
                                        @if (_healthData.Summary.UnstablePipelines > 0) {
                                            <span class="text-warning me-3"><i class="fa fa-exclamation-triangle me-1"></i>@_healthData.Summary.UnstablePipelines unstable</span>
                                        }
                                        @if (_healthData.Summary.FailingPipelines > 0) {
                                            <span class="text-danger me-3"><i class="fa fa-times-circle me-1"></i>@_healthData.Summary.FailingPipelines failing</span>
                                        }
                                    </div>
                                    <div class="vr"></div>
                                    <div class="small text-muted">
                                        @_healthData.Summary.TotalBuildsAnalyzed builds analyzed
                                    </div>
                                </div>

                                @* Health Progress Bar *@
                                <div class="progress mb-3" style="height: 6px;">
                                    @if (_healthData.Summary.TotalBuildsAnalyzed > 0) {
                                        var successPct = _healthData.Summary.TotalSucceeded * 100.0 / _healthData.Summary.TotalBuildsAnalyzed;
                                        var failPct = _healthData.Summary.TotalFailed * 100.0 / _healthData.Summary.TotalBuildsAnalyzed;
                                        var otherPct = 100 - successPct - failPct;
                                        <div class="progress-bar bg-success" style="width: @Helpers.CssPercent(successPct)%"></div>
                                        <div class="progress-bar bg-danger" style="width: @Helpers.CssPercent(failPct)%"></div>
                                        <div class="progress-bar bg-secondary-subtle" style="width: @Helpers.CssPercent(otherPct)%"></div>
                                    }
                                </div>

                                @* Per-Pipeline Sparklines — show worst performers first, limit to pipelines with builds *@
                                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2">
                                    @foreach (var trend in _healthData.Pipelines.Where(p => p.RecentResults.Any()).Take(18)) {
                                        var nameColor = trend.SuccessRate >= 80 ? "" : trend.SuccessRate >= 50 ? "text-warning" : "text-danger";
                                        var streakText = trend.Streak > 0 ? $"{trend.Streak} in a row ✅" : trend.Streak < 0 ? $"{Math.Abs(trend.Streak)} in a row ❌" : "";
                                        <div class="col">
                                            <div class="d-flex align-items-center gap-2 py-1 px-2 rounded" title="@trend.Name — @trend.SuccessRate% success rate @(string.IsNullOrWhiteSpace(streakText) ? "" : $"({streakText})")">
                                                <span class="small @nameColor text-truncate" style="min-width: 100px; max-width: 140px;">
                                                    @trend.Name
                                                </span>
                                                <div class="d-flex align-items-center gap-0" style="gap: 1px !important;">
                                                    @foreach (var result in trend.RecentResults) {
                                                        @* A recent result is a finished build's result, or "inprogress" for one still running. *@
                                                        var dotKind = result == "inprogress" ? DashboardView.RunKind.Running : DashboardView.Classify("completed", result);
                                                        var dotIcon = dotKind == DashboardView.RunKind.Running ? "fa-spinner fa-spin" : "fa-circle";
                                                        <i class="fa @dotIcon @DashboardView.Status(dotKind).TextClass" style="font-size: 0.55em; margin: 0 1px;"></i>
                                                    }
                                                </div>
                                                <span class="small text-muted ms-auto" style="min-width: 30px; text-align: right;">@(trend.SuccessRate)%</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    } else if (!string.IsNullOrWhiteSpace(_healthData?.ErrorMessage)) {
                        <div class="mt-2 alert alert-warning small">
                            <i class="fa fa-exclamation-triangle me-1"></i>@_healthData.ErrorMessage
                        </div>
                    }
                }
            </div>

            @* Summary Footer *@
            <div class="mt-4 d-flex justify-content-between align-items-center text-muted small">
                <div>
                    Showing @_filtered.Count
                    @if (_dashboardResponse?.Pipelines?.Count != _filtered.Count) {
                        <span>of @(_dashboardResponse?.Pipelines?.Count ?? 0)</span>
                    }
                    pipeline(s)
                    @if (_groupByFolder && _rootFolders.Count > 1) {
                        <span>in @_rootFolders.Count folders</span>
                    }
                    @if (_autoRefresh) {
                        <DashboardLiveIndicator State="_live" Part="footer" />
                    }
                </div>
                <div>
                    @foreach (var (kind, count) in new[] {
                        (DashboardView.RunKind.Succeeded, _footerCounts.Succeeded), (DashboardView.RunKind.Failed, _footerCounts.Failed),
                        (DashboardView.RunKind.Partial, _footerCounts.Partial), (DashboardView.RunKind.Running, _footerCounts.Running) }) {
                        if (count > 0) {
                            var style = DashboardView.Status(kind);
                            <span class="me-2" title="@count @style.Label"><i class="fa @style.Icon @style.TextClass me-1"></i>@count</span>
                        }
                    }
                </div>
            </div>
        }
    </div>

@code {
    /// <summary>
    /// One folder as a collapsible group: a header with the folder name and its status counts, then its subfolders
    /// and its own pipelines. Nested folders are indented and coloured by depth.
    /// </summary>
    private RenderFragment RenderFolderNode(FolderNode folder) => __builder =>
    {
        var expanded = _expandedGroups.Contains(folder.FullPath);
        <div @key="folder.FullPath" class="pipeline-group card mb-3 shadow-sm border-0" style="@(folder.Depth <= 0 ? "" : $"margin-left: {Helpers.CssPercent(folder.Depth * 1.5)}rem;")">
            @* The accordion pattern: a heading holding a real button, so Tab reaches it and Enter or Space toggles it. *@
            <div class="card-header p-0 @(expanded ? "" : "border-bottom-0")">
                <h6 class="mb-0">
                <button type="button" class="d-flex justify-content-between align-items-center w-100 px-3 py-3 border-0 bg-transparent text-reset text-start"
                        @onclick="@(() => OnGroupExpandedChanged(folder.FullPath, !expanded))"
                        aria-expanded="@(expanded ? "true" : "false")"
                        aria-controls="group-content-@folder.GroupId">
                    <span class="d-flex align-items-center gap-2">
                        <i class="fa @(expanded ? "fa-chevron-down" : "fa-chevron-right") text-muted" aria-hidden="true"></i>
                        <i class="fa fa-folder@(expanded ? "-open" : "") @FolderColorClass(folder.Depth)" aria-hidden="true"></i>
                        <span class="fw-semibold @FolderHeaderSizeClass(folder.Depth)">@folder.Name</span>
                        <span class="badge bg-secondary rounded-pill">@folder.TotalCount</span>
                    </span>

                    <span class="d-flex gap-2">
                        @foreach (var (kind, count) in new[] {
                            (DashboardView.RunKind.Succeeded, folder.Counts.Succeeded), (DashboardView.RunKind.Failed, folder.Counts.Failed),
                            (DashboardView.RunKind.Partial, folder.Counts.Partial), (DashboardView.RunKind.Running, folder.Counts.Running),
                            (DashboardView.RunKind.Queued, folder.Counts.Queued) }) {
                            if (count > 0) {
                                var style = DashboardView.Status(kind);
                                <span class="badge @style.BadgeClass" title="@count @style.Label">
                                    <i class="fa @style.Icon me-1"></i>@count
                                </span>
                            }
                        }
                    </span>
                </button>
                </h6>
            </div>

            @if (expanded) {
                <div class="card-body pt-3" id="group-content-@folder.GroupId">
                    @* Subfolders first, then the pipelines in this folder. *@
                    @foreach (var subFolder in folder.SubFolders) {
                        @RenderFolderNode(subFolder)
                    }

                    @if (folder.Pipelines.Count > 0) {
                        @if (_viewMode == "card") {
                            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3 @(folder.SubFolders.Count > 0 ? "mt-2" : "")">
                                @foreach (var pipeline in folder.Pipelines) {
                                    <div class="col" @key="pipeline.Id">
                                        @RenderPipelineCard(pipeline)
                                    </div>
                                }
                            </div>
                        } else {
                            <div class="@(folder.SubFolders.Count > 0 ? "mt-2" : "")">
                                <FreeCICD_App_UI_Dashboard_TableView
                                    Pipelines="@folder.Pipelines"
                                    SortColumn="@DashboardView.Sort(_sortBy).Column"
                                    SortAscending="@DashboardView.Sort(_sortBy).Ascending"
                                    OnSortChanged="@OnTableSortChanged"
                                    OnCopyYaml="@OnCopyYaml"
                                    OnRunPipeline="@OnRunPipeline" />
                            </div>
                        }
                    }
                </div>
            }
        </div>
    };

    // Root folders are gold, then blue, green and grey as they nest; nested headers get a little smaller.
    private static string FolderColorClass(int depth) => depth switch {
        0 => "text-warning",
        1 => "text-info",
        2 => "text-success",
        _ => "text-secondary"
    };

    private static string FolderHeaderSizeClass(int depth) => depth switch {
        0 => "",
        1 => "fs-6",
        _ => "small"
    };

    /// <summary>The view mode toggle (Card/Table), the group-by-folder switch, the sort list and, when grouped, expand/collapse all.</summary>
    private RenderFragment RenderViewControls() => __builder =>
    {
        <div class="pipeline-view-controls mb-3">
            <div class="d-flex flex-wrap gap-3 align-items-center justify-content-between">
                <div class="d-flex flex-wrap gap-3 align-items-center">
                    <div class="btn-group" role="group" aria-label="View mode">
                        <button type="button"
                                class="btn @(_viewMode == "card" ? "btn-primary" : "btn-outline-primary")"
                                @onclick="@(() => OnViewModeChanged("card"))"
                                title="Card View">
                            <i class="fa fa-th-large me-1"></i>
                            Cards
                        </button>
                        <button type="button"
                                class="btn @(_viewMode == "table" ? "btn-primary" : "btn-outline-primary")"
                                @onclick="@(() => OnViewModeChanged("table"))"
                                title="Table View">
                            <i class="fa fa-list me-1"></i>
                            Table
                        </button>
                    </div>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="groupByFolderSwitch"
                               checked="@_groupByFolder" @onchange="@(e => OnGroupByFolderChanged((bool)(e.Value ?? false)))" />
                        <label class="form-check-label" for="groupByFolderSwitch">
                            <i class="fa-regular fa-folder me-1"></i>
                            Group by Folder
                        </label>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <label class="form-label mb-0 text-muted small">Sort:</label>
                        <select class="form-select form-select-sm" style="width: auto;" value="@_sortBy" @onchange="@(e => OnSortByChanged(e.Value?.ToString() ?? _sortBy))">
                            @foreach (var sort in DashboardView.Sorts) {
                                <option value="@sort.Key">@sort.Label</option>
                            }
                        </select>
                    </div>
                </div>

                @if (_groupByFolder) {
                    <div class="btn-group" role="group" aria-label="Expand/Collapse">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OnExpandAll" title="Expand All">
                            <i class="fa fa-expand me-1"></i>
                            Expand All
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OnCollapseAll" title="Collapse All">
                            <i class="fa fa-compress me-1"></i>
                            Collapse All
                        </button>
                    </div>
                }
            </div>
        </div>
    };

    /// <summary>
    /// One pipeline as a card: name, build number and branch in the header with the status badge, then repository,
    /// commit, last run, trigger, stages, YAML file and variable groups, and the Edit / Runs / actions footer. The
    /// badges are the same fragments the table row uses, so the two views cannot drift apart.
    /// </summary>
    private RenderFragment RenderPipelineCard(DataObjects.PipelineListItem pipeline) => __builder =>
    {
        var branch = DashboardView.DisplayBranch(pipeline);
        var repoName = DashboardView.DisplayRepoName(pipeline);
        <div class="card h-100 shadow-sm border-0 pipeline-card">
            <div class="card-header bg-body border-bottom-0 py-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1 me-2">
                        <h6 class="card-title mb-0 d-flex align-items-center flex-wrap gap-1">
                            <a href="@pipeline.ResourceUrl" target="_blank"
                               class="text-decoration-none text-body pipeline-title-link text-truncate"
                               title="@pipeline.Name - Open in Azure DevOps"
                               style="max-width: 180px;">
                                @pipeline.Name
                            </a>
                            @if (!string.IsNullOrWhiteSpace(pipeline.LastRunBuildNumber)) {
                                <a href="@pipeline.PipelineRunsUrl" target="_blank"
                                   class="text-muted small text-decoration-none link-underline-opacity-0 link-underline-opacity-75-hover"
                                   title="View all runs for #@pipeline.LastRunBuildNumber">
                                    #@Helpers.MaxStringLength(pipeline.LastRunBuildNumber, 10)
                                </a>
                            }
                        </h6>
                        @if (!string.IsNullOrWhiteSpace(branch)) {
                            <div class="mt-1">
                                <BranchBadge Branch="@branch" BranchUrl="@pipeline.CodeBranchUrl" MaxLength="18" />
                            </div>
                        }
                    </div>
                    @RenderRunStatusBadge(pipeline)
                </div>
            </div>

            <div class="card-body pt-0">
                @* The code repository is preferred over the repository that holds the YAML. *@
                @if (!string.IsNullOrWhiteSpace(repoName)) {
                    <div class="small mb-2">
                        <a href="@DashboardView.DisplayRepoUrl(pipeline)" target="_blank"
                           class="text-muted text-decoration-none link-underline-opacity-0 link-underline-opacity-75-hover"
                           title="Open @repoName repository">
                            <i class="fa fa-database me-1"></i>@repoName
                        </a>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(pipeline.LastCommitId)) {
                    <div class="small mb-2">
                        @RenderCommitLink(pipeline)
                    </div>
                }

                <div class="small text-muted d-flex align-items-center gap-2 flex-wrap mb-1">
                    @RenderLastRun(pipeline, iconClass: "fa-calendar", linkClass: "text-muted")
                    @if (pipeline.Duration.HasValue) {
                        <span class="text-muted">•</span>
                        <span title="@DashboardView.FormatDurationFull(pipeline.Duration)">
                            <i class="fa-regular fa-clock me-1"></i>
                            @DashboardView.FormatDuration(pipeline.Duration)
                        </span>
                    }
                </div>

                <div class="small text-muted d-flex align-items-center gap-2 flex-wrap">
                    @RenderTriggerBadge(pipeline, avatarSize: 18)
                </div>

                @RenderStageBubbles(pipeline.Stages, label: "Stages:", cssClass: "small mt-1", iconSize: "0.8em")

                @if (!string.IsNullOrWhiteSpace(pipeline.YamlFileName)) {
                    <div class="small text-muted mt-1 text-truncate" title="@pipeline.YamlFileName">
                        <i class="fa-regular fa-file-code me-1"></i>
                        @System.IO.Path.GetFileName(pipeline.YamlFileName)
                    </div>
                }

                @if (pipeline.VariableGroups?.Any() == true) {
                    <div class="mt-2">
                        @RenderVarGroupBadges(pipeline.VariableGroups)
                    </div>
                }
            </div>

            @* Real anchors, so right-click and middle-click open them in a new tab. *@
            <div class="card-footer bg-body border-top-0 pt-0">
                <div class="d-flex gap-2">
                    <a href="@(Helpers.BuildUrl(pipeline.EditWizardUrl))"
                       class="btn btn-sm btn-outline-primary flex-grow-1"
                       title="Edit in Wizard">
                        <i class="fa fa-pencil me-1"></i>
                        Edit
                    </a>
                    <a href="@pipeline.PipelineRunsUrl" target="_blank"
                       class="btn btn-sm btn-outline-info flex-grow-1"
                       title="View pipeline runs">
                        <i class="fa fa-list me-1"></i>
                        Runs
                    </a>
                    <FreeCICD_App_UI_Dashboard_ActionsMenu Pipeline="@pipeline" OnRunPipeline="@OnRunPipeline" OnCopyYaml="@OnCopyYaml" />
                </div>
            </div>
        </div>
    };

    // The badges below are shared by the card above and the table row (FreeCICD_App_UI_Dashboard_TableView), so the
    // two views cannot drift apart. They are static and have no event handlers so the table can call them.

    /// <summary>A pipeline's last-run status badge, linked to the build results when Azure DevOps gave a link.</summary>
    public static RenderFragment RenderRunStatusBadge(DataObjects.PipelineListItem pipeline) => __builder =>
    {
        var status = DashboardView.Status(pipeline);
        @if (!string.IsNullOrWhiteSpace(pipeline.LastRunResultsUrl)) {
            <a href="@pipeline.LastRunResultsUrl" target="_blank"
               class="text-decoration-none clickable-badge"
               title="View build results in Azure DevOps">
                <span class="badge @status.BadgeClass"><i class="fa @status.Icon me-1"></i>@status.Label</span>
            </a>
        } else {
            <span class="badge @status.BadgeClass"><i class="fa @status.Icon me-1"></i>@status.Label</span>
        }
    };

    /// <summary>
    /// Who or what started the last run: the user's avatar and the trigger badge, linked to the pipeline's trigger
    /// settings when Azure DevOps gave a link. A table cell must not be empty, so it can show a dash when unknown.
    /// </summary>
    public static RenderFragment RenderTriggerBadge(DataObjects.PipelineListItem pipeline, int avatarSize = 20, bool showDashWhenUnknown = false) => __builder =>
    {
        @if (!string.IsNullOrWhiteSpace(pipeline.TriggeredByAvatarUrl)) {
            <img src="@pipeline.TriggeredByAvatarUrl"
                 alt="@pipeline.TriggeredByUser"
                 title="@pipeline.TriggeredByUser"
                 class="rounded-circle"
                 style="width: @(avatarSize)px; height: @(avatarSize)px; object-fit: cover;"
                 onerror="this.style.display='none'" />
        }
        @if (string.IsNullOrWhiteSpace(pipeline.TriggerReason)) {
            @if (showDashWhenUnknown) {
                <span class="text-muted">—</span>
            }
        } else {
            var trigger = DashboardView.Trigger(pipeline);
            @if (!string.IsNullOrWhiteSpace(pipeline.PipelineConfigUrl)) {
                <a href="@pipeline.PipelineConfigUrl" target="_blank"
                   class="text-decoration-none clickable-badge"
                   title="@trigger.Tooltip. Configure pipeline triggers in Azure DevOps">
                    <span class="badge @trigger.BadgeClass"><i class="fa @trigger.Icon me-1"></i>@trigger.Text</span>
                </a>
            } else {
                <span class="badge @trigger.BadgeClass" title="@trigger.Tooltip"><i class="fa @trigger.Icon me-1"></i>@trigger.Text</span>
            }
        }
    };

    /// <summary>The last run's commit id, linked to the commit in Azure DevOps; nothing when the run has no commit.</summary>
    public static RenderFragment RenderCommitLink(DataObjects.PipelineListItem pipeline) => __builder =>
    {
        @if (!string.IsNullOrWhiteSpace(pipeline.LastCommitId)) {
            <a href="@pipeline.CommitUrl" target="_blank"
               class="text-muted font-monospace text-decoration-none link-underline-opacity-0 link-underline-opacity-75-hover"
               title="View commit @pipeline.LastCommitId in Azure DevOps">
                <i class="fa fa-code-fork me-1"></i>@pipeline.LastCommitId
            </a>
        }
    };

    /// <summary>
    /// When the pipeline last ran ("5 minutes ago", the exact time in the tooltip), linked to the build logs when
    /// Azure DevOps gave a link. The card puts a calendar icon before it; the table marks the link as external.
    /// </summary>
    public static RenderFragment RenderLastRun(DataObjects.PipelineListItem pipeline, string? iconClass = null, string linkClass = "link-body-emphasis", bool showLinkIcon = false) => __builder =>
    {
        @if (pipeline.LastRunTime.HasValue) {
            @if (!string.IsNullOrWhiteSpace(pipeline.LastRunLogsUrl)) {
                <a href="@pipeline.LastRunLogsUrl" target="_blank"
                   class="@linkClass text-decoration-none link-underline-opacity-0 link-underline-opacity-75-hover"
                   title="View build logs - @Helpers.FormatDateTime(pipeline.LastRunTime)">
                    @if (!string.IsNullOrWhiteSpace(iconClass)) {
                        <i class="fa @iconClass me-1"></i>
                    }
                    @pipeline.LastRunTime.Value.Humanize()
                    @if (showLinkIcon) {
                        <i class="fa fa-external-link-square ms-1 small text-muted"></i>
                    }
                </a>
            } else {
                <span title="@Helpers.FormatDateTime(pipeline.LastRunTime)" class="cursor-help">
                    @if (!string.IsNullOrWhiteSpace(iconClass)) {
                        <i class="fa @iconClass me-1"></i>
                    }
                    @pipeline.LastRunTime.Value.Humanize()
                </span>
            }
        } else {
            <span class="text-muted">
                @if (!string.IsNullOrWhiteSpace(iconClass)) {
                    <i class="fa @iconClass me-1"></i>
                }
                Never run
            </span>
        }
    };

    /// <summary>The pipeline's variable group (Library) badges, one per environment; nothing when it has none.</summary>
    public static RenderFragment RenderVarGroupBadges(List<DataObjects.PipelineVariableGroupRef>? variableGroups) => __builder =>
    {
        @if (variableGroups?.Any() == true) {
            <div class="d-flex flex-wrap gap-1">
                @foreach (var group in variableGroups) {
                    var envLabel = DashboardView.EnvironmentLabel(group.Environment);
                    var tooltip = group.Name + (group.VariableCount > 0 ? $" ({group.VariableCount} vars)" : "");

                    @if (!string.IsNullOrWhiteSpace(group.ResourceUrl)) {
                        <a href="@group.ResourceUrl" target="_blank"
                           class="badge @Helpers.EnvBadgeClass(group.Environment) text-decoration-none library-link"
                           title="@tooltip">
                            @envLabel
                            <i class="fa fa-external-link-square ms-1 small"></i>
                        </a>
                    } else {
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border" title="@tooltip (not found)">
                            @envLabel
                        </span>
                    }
                }
            </div>
        }
    };

    /// <summary>
    /// The last run's stages as a row of small status icons in stage order, each named in its tooltip; nothing when
    /// the run has no stages. The label goes before the icons (the card's "Stages:"), the icon size matches the text
    /// around them, and anything in <paramref name="after"/> follows on the same row (the table's expand button).
    /// </summary>
    public static RenderFragment RenderStageBubbles(List<DataObjects.StageBubble>? stages, string? label = null, string cssClass = "", string iconSize = "0.85em", RenderFragment? after = null) => __builder =>
    {
        @if (stages?.Any() == true) {
            <div class="@cssClass d-flex align-items-center gap-0 flex-wrap" style="gap: 2px !important;">
                @if (!string.IsNullOrWhiteSpace(label)) {
                    <span class="text-muted me-1" style="font-size: 0.8em;">@label</span>
                }
                @foreach (var stage in stages.OrderBy(s => s.Order)) {
                    var stageStyle = DashboardView.Stage(stage.State, stage.Result);
                    <i class="fa @stageStyle.Icon @stageStyle.TextClass" style="font-size: @iconSize; margin: 0 1px;" title="@stage.Name: @stageStyle.Label"></i>
                }
                @after
            </div>
        }
    };
}
