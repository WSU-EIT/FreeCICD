    /// <summary>
    /// The card header: a step number, spinner or icon badge with the title, then the buttons the state allows.
    /// Start Over and Create Another start over, Back goes back, Next runs the step's own Next (or moves on), and
    /// Save moves on from the save step.
    /// </summary>
    private RenderFragment RenderStepHeader(string title, string headerClass = "bg-dark text-white", int stepNumber = 0,
        bool showSpinner = false, string spinnerText = "Loading...", string badgeIcon = "", string badgeClass = "bg-light text-success",
        bool showStartOver = false, bool showBack = false, bool showNext = false, bool showSave = false, bool showCreateAnother = false,
        string infoText = "", bool isDisabled = false, bool nextDisabled = false, WizardStep? step = null) => __builder =>
    {
        <div class="card-header @headerClass d-flex justify-content-between align-items-center flex-wrap gap-2 py-3">
            <div class="d-flex align-items-center gap-2">
                @if (showSpinner) {
                    <div class="spinner-border spinner-border-sm" role="status">
                        <span class="visually-hidden">@spinnerText</span>
                    </div>
                } else if (!string.IsNullOrWhiteSpace(badgeIcon)) {
                    <span class="badge @badgeClass"><i class="fa @badgeIcon"></i></span>
                } else {
                    <span class="badge bg-secondary">Step @stepNumber</span>
                }
                <span class="fw-semibold">@title</span>
            </div>
            <div class="d-flex gap-2">
                @if (showStartOver) {
                    <button class="btn btn-outline-light btn-sm" @onclick="StartOver" disabled="@isDisabled">
                        <i class="fa fa-refresh me-1"></i>
                        Start Over
                    </button>
                }
                @if (showBack) {
                    <button class="btn btn-secondary btn-sm" @onclick="PrevStep" disabled="@isDisabled">
                        <i class="fa fa-arrow-left me-1"></i>
                        Back
                    </button>
                }
                @if (showNext) {
                    <button class="btn btn-primary btn-sm" @onclick="@(() => step?.Next != null ? step.Next() : NextStep(step?.Name))" disabled="@(isDisabled || nextDisabled)">
                        Next
                        <i class="fa fa-arrow-right ms-1"></i>
                    </button>
                }
                @if (showSave) {
                    <button class="btn btn-success btn-sm" @onclick="@(() => NextStep(step?.Name))" disabled="@isDisabled">
                        <i class="fa fa-save me-1"></i>
                        Save YAML &amp; Pipeline
                    </button>
                }
                @if (showCreateAnother) {
                    <button class="btn btn-light btn-sm" @onclick="StartOver">
                        <i class="fa fa-refresh me-1"></i>
                        Create Another Pipeline
                    </button>
                }
                @if (!string.IsNullOrWhiteSpace(infoText)) {
                    <span class="text-muted small">@infoText</span>
                }
            </div>
        </div>
    };

