@* NuGet Package Inventory Component *@
@* Displays .csproj files, NuGet packages, and target frameworks across the entire Azure DevOps organization. *@
@* Uses SignalR for progressive loading status updates. *@

@inherits AppLoadingPageBase

@code {
    protected override string PageName => AppViews.NuGetInventory;
    protected override string? LoadCompleteUpdate => DataObjects.SignalRUpdateType.NuGetInventoryLoadComplete;
    protected override Task LoadAsync() => LoadInventory();
    protected override string InitialLoadingMessage => "Loading inventory...";

    protected DataObjects.NuGetInventoryResponse? _inventoryResponse;

    // Filter state
    protected string _searchTerm = "";
    protected string _selectedFramework = "";
    protected bool _multiVersionOnly = false;

    // View state
    protected string _activeTab = "packages"; // packages, projects, frameworks

    // Sort state (packages tab): name, versions or uses
    protected SortState _sort = new("name", true);

    // Expand state — project tree
    protected HashSet<string> _expandedProjects = [];
    protected HashSet<string> _expandedRepos = [];
    protected HashSet<string> _expandedBranches = [];
    protected HashSet<string> _expandedCsproj = [];

    // Expand state — packages tab drill-down
    protected HashSet<string> _expandedPackages = [];

    // Expand state — frameworks tab
    protected HashSet<string> _expandedFrameworks = [];

    protected record struct PackageUsage(string Project, string Repo, string Branch, string CsprojPath, string? Framework, string Version);
    protected record struct FrameworkItem(string Project, string Repo, string Csproj, string Framework);

    // ── Indexes, built once per load: an org can have ~20k package references, so nothing below walks the tree per render ──
    protected Dictionary<string, int> _frameworkCsprojCounts = new(StringComparer.OrdinalIgnoreCase);
    protected Dictionary<string, HashSet<string>> _frameworkPackageNames = new(StringComparer.OrdinalIgnoreCase);
    protected HashSet<string> _conflictingPackages = new(StringComparer.OrdinalIgnoreCase);
    protected Dictionary<string, List<PackageUsage>> _packageUsages = new(StringComparer.OrdinalIgnoreCase);
    protected Dictionary<string, (int Csproj, int PackageRefs)> _projectCounts = new();
    protected List<FrameworkItem> _frameworkItems = [];
    // Per project: its name, repos, .csproj paths and package names joined by newlines (which the search box cannot
    // contain, so a term never matches across two names), its target frameworks, and whether it uses a conflicting package.
    protected Dictionary<string, string> _projectSearchText = new();
    protected Dictionary<string, HashSet<string>> _projectFrameworks = new();
    protected HashSet<string> _projectsWithConflicts = new();

    // ── Filtered and sorted view of the open tab, recomputed only when the data, a filter, the sort or the tab changes ──
    protected List<DataObjects.PackageSummaryItem> _filteredPackages = [];
    protected List<DataObjects.ProjectInventory> _filteredProjects = [];
    protected List<IGrouping<string, FrameworkItem>> _frameworkGroups = [];
    protected (DataObjects.NuGetInventoryResponse? Data, string Search, string Framework, bool MultiVersion, string SortColumn, bool SortAscending, string Tab)? _filterKey;

    // Computed: total unfiltered counts for "Showing X of Y" display
    protected int TotalPackageCount => _inventoryResponse?.PackageSummary?.Count ?? 0;
    protected int TotalProjectCount => _inventoryResponse?.Projects?.Count ?? 0;
    protected int TotalFrameworkCount => _frameworkCsprojCounts.Count;

    protected List<PackageUsage> GetPackageUsages(string packageName) =>
        _packageUsages.TryGetValue(packageName, out var usages) ? usages : [];

    protected int GetFrameworkCsprojCount(string framework) =>
        _frameworkCsprojCounts.TryGetValue(framework, out var count) ? count : 0;

    /// <summary>
    /// Builds the lookup tables for one inventory response, and sorts its tree once so the markup does not sort per render.
    /// </summary>
    protected void BuildIndexes(DataObjects.NuGetInventoryResponse response)
    {
        _frameworkCsprojCounts = new(StringComparer.OrdinalIgnoreCase);
        _frameworkPackageNames = new(StringComparer.OrdinalIgnoreCase);
        _packageUsages = new(StringComparer.OrdinalIgnoreCase);
        _projectCounts = new();
        _frameworkItems = [];
        _projectSearchText = new();
        _projectFrameworks = new();
        _projectsWithConflicts = new();
        _conflictingPackages = (response.PackageSummary ?? [])
            .Where(p => p.HasMultipleVersions).Select(p => p.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var project in response.Projects ?? []) {
            int csprojCount = 0;
            int packageRefs = 0;
            var searchText = new System.Text.StringBuilder(project.Name);
            var frameworks = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            project.Repos.Sort((a, b) => string.Compare(a.Name, b.Name, StringComparison.Ordinal));
            foreach (var repo in project.Repos) {
                searchText.Append('\n').Append(repo.Name);
                repo.Branches.Sort((a, b) => string.Compare(a.Name, b.Name, StringComparison.Ordinal));
                foreach (var branch in repo.Branches) {
                    branch.CsprojFiles.Sort((a, b) => string.Compare(a.Path, b.Path, StringComparison.Ordinal));
                    foreach (var csproj in branch.CsprojFiles) {
                        csproj.Packages.Sort((a, b) => string.Compare(a.Name, b.Name, StringComparison.Ordinal));
                        csprojCount++;
                        packageRefs += csproj.Packages.Count;
                        searchText.Append('\n').Append(csproj.Path);

                        HashSet<string>? fwNames = null;
                        if (!string.IsNullOrEmpty(csproj.TargetFramework)) {
                            frameworks.Add(csproj.TargetFramework);
                            _frameworkCsprojCounts[csproj.TargetFramework] = GetFrameworkCsprojCount(csproj.TargetFramework) + 1;
                            if (!_frameworkPackageNames.TryGetValue(csproj.TargetFramework, out fwNames)) {
                                fwNames = new(StringComparer.OrdinalIgnoreCase);
                                _frameworkPackageNames[csproj.TargetFramework] = fwNames;
                            }
                            _frameworkItems.Add(new FrameworkItem(project.Name, repo.Name, csproj.Path, csproj.TargetFramework));
                        }

                        foreach (var pkg in csproj.Packages) {
                            searchText.Append('\n').Append(pkg.Name);
                            if (_conflictingPackages.Contains(pkg.Name)) {
                                _projectsWithConflicts.Add(project.Id);
                            }
                            fwNames?.Add(pkg.Name);
                            if (!_packageUsages.TryGetValue(pkg.Name, out var usages)) {
                                usages = [];
                                _packageUsages[pkg.Name] = usages;
                            }
                            usages.Add(new PackageUsage(project.Name, repo.Name, branch.Name, csproj.Path, csproj.TargetFramework, pkg.Version));
                        }
                    }
                }
            }
            _projectCounts[project.Id] = (csprojCount, packageRefs);
            _projectSearchText[project.Id] = searchText.ToString();
            _projectFrameworks[project.Id] = frameworks;
        }

        foreach (var key in _packageUsages.Keys.ToList()) {
            _packageUsages[key] = _packageUsages[key]
                .OrderBy(x => x.Project).ThenBy(x => x.Repo).ThenBy(x => x.Branch).ThenBy(x => x.CsprojPath)
                .ToList();
        }

        _filterKey = null;
    }

    /// <summary>
    /// Recomputes the open tab's filtered list when the data, a filter, the sort or the tab changed since the last
    /// render. Only the open tab is filtered: the project filter reads every package reference, which a keystroke
    /// on another tab should not pay for. Called at the top of the markup because the filters are bound inputs
    /// with no change handler.
    /// </summary>
    protected void EnsureFiltered()
    {
        var key = (_inventoryResponse, _searchTerm ?? "", _selectedFramework ?? "", _multiVersionOnly, _sort.Column, _sort.Ascending, _activeTab);
        if (_filterKey.HasValue && _filterKey.Value.Equals(key)) {
            return;
        }
        _filterKey = key;

        _filteredPackages = [];
        _filteredProjects = [];
        _frameworkGroups = [];
        if (_inventoryResponse == null) {
            return;
        }

        string search = (_searchTerm ?? "").Trim();
        bool hasSearch = search.Length > 0;
        bool hasFramework = !string.IsNullOrWhiteSpace(_selectedFramework);
        bool Match(string? value) => value != null && value.Contains(search, StringComparison.OrdinalIgnoreCase);

        switch (_activeTab) {
            case "packages":
                _filteredPackages = FilterPackages(hasSearch, hasFramework, Match);
                break;
            case "projects":
                var projects = (_inventoryResponse.Projects ?? []).AsEnumerable();
                if (hasSearch) {
                    projects = projects.Where(p => Match(_projectSearchText.GetValueOrDefault(p.Id)));
                }
                if (hasFramework) {
                    projects = projects.Where(p => _projectFrameworks.TryGetValue(p.Id, out var fws) && fws.Contains(_selectedFramework!));
                }
                if (_multiVersionOnly) {
                    projects = projects.Where(p => _projectsWithConflicts.Contains(p.Id));
                }
                _filteredProjects = projects.ToList();
                break;
            default:
                var items = _frameworkItems.AsEnumerable();
                if (hasSearch) {
                    items = items.Where(x => Match(x.Project) || Match(x.Repo) || Match(x.Csproj) || Match(x.Framework));
                }
                if (hasFramework) {
                    items = items.Where(x => string.Equals(x.Framework, _selectedFramework, StringComparison.OrdinalIgnoreCase));
                }
                _frameworkGroups = items
                    .GroupBy(x => x.Framework, StringComparer.OrdinalIgnoreCase)
                    .OrderBy(g => g.Key)
                    .ToList();
                break;
        }
    }

    protected List<DataObjects.PackageSummaryItem> FilterPackages(bool hasSearch, bool hasFramework, Func<string?, bool> match)
    {
        var packages = (_inventoryResponse?.PackageSummary ?? []).AsEnumerable();
        if (hasSearch) {
            packages = packages.Where(p => match(p.Name) || p.Versions.Any(match));
        }
        if (_multiVersionOnly) {
            packages = packages.Where(p => p.HasMultipleVersions);
        }
        if (hasFramework) {
            var fwPackages = _frameworkPackageNames.TryGetValue(_selectedFramework ?? "", out var names) ? names : [];
            packages = packages.Where(p => fwPackages.Contains(p.Name));
        }
        return _sort.Column switch {
            "versions" => _sort.Ascending ? packages.OrderBy(p => p.Versions.Count).ThenBy(p => p.Name).ToList()
                                          : packages.OrderByDescending(p => p.Versions.Count).ThenBy(p => p.Name).ToList(),
            "uses"     => _sort.Ascending ? packages.OrderBy(p => p.UsageCount).ThenBy(p => p.Name).ToList()
                                          : packages.OrderByDescending(p => p.UsageCount).ThenBy(p => p.Name).ToList(),
            _          => _sort.Ascending ? packages.OrderBy(p => p.Name).ToList()
                                          : packages.OrderByDescending(p => p.Name).ToList()
        };
    }

    /// <summary>A tab's count: the filtered count for the open tab, the unfiltered total for the others (they are filtered when opened).</summary>
    protected int TabCount(string tab) => tab switch {
        "packages" => _activeTab == tab ? _filteredPackages.Count : TotalPackageCount,
        "projects" => _activeTab == tab ? _filteredProjects.Count : TotalProjectCount,
        _ => _activeTab == tab ? _frameworkGroups.Count : TotalFrameworkCount,
    };

    protected Task LoadInventory() => RunLoadAsync("Connecting to Azure DevOps...", "Error loading inventory", async () => {
        var response = await Helpers.GetOrPost<DataObjects.NuGetInventoryResponse>(
            DataObjects.Endpoints.NuGetInventory.GetInventory + Helpers.ConnectionIdQuery());

        if (response != null) {
            BuildIndexes(response);
            _inventoryResponse = response;
            if (!response.Success && !string.IsNullOrWhiteSpace(response.ErrorMessage)) {
                _errorMessage = response.ErrorMessage;
            }
        } else {
            _errorMessage = "Failed to load NuGet inventory. Please try again.";
        }
    });

    protected async Task RefreshInventory()
    {
        _inventoryResponse = null;
        await LoadInventory();
    }

    protected void SetActiveTab(string tab)
    {
        _activeTab = tab;
        StateHasChanged();
    }

    // Names start A-Z; the counts start with the largest.
    protected void SortPackages(string column) => _sort.Toggle(column, defaultAscending: column == "name");

    /// <summary>A package version badge: red when the org uses more than one version of the package, else green.</summary>
    protected static string VersionBadgeClass(bool conflict) => conflict ? "bg-danger" : "bg-success";

    protected void ExpandAll()
    {
        if (_inventoryResponse?.Projects != null) {
            foreach (var p in _inventoryResponse.Projects) {
                _expandedProjects.Add(p.Id);
                foreach (var r in p.Repos) {
                    var repoKey = p.Id + "/" + r.Id;
                    _expandedRepos.Add(repoKey);
                    foreach (var b in r.Branches) {
                        _expandedBranches.Add(repoKey + "/" + b.Name);
                    }
                }
            }
        }
    }

    protected void CollapseAll()
    {
        _expandedProjects.Clear();
        _expandedRepos.Clear();
        _expandedBranches.Clear();
        _expandedCsproj.Clear();
    }

    // The page title, shared by the loading, error and loaded states.
    protected RenderFragment PageHeader(bool showRescan) => __builder => {
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
            <h1 class="page-title mb-0">
                <Icon Name="NuGetInventory" /> NuGet Inventory
            </h1>
            @if (showRescan) {
                <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshInventory">
                    <i class="fa-solid fa-rotate me-1"></i> Rescan
                </button>
            }
        </div>
    };
}

@{ EnsureFiltered(); }

@if (_loading) {
    @PageHeader(false)
    <FreeCICD_App_UI_Loading Inline="true" Message="@_loadingMessage" />
} else if (!string.IsNullOrWhiteSpace(_errorMessage)) {
    @PageHeader(false)
    <div class="alert alert-danger">
        <i class="fa-solid fa-triangle-exclamation me-2"></i> @_errorMessage
    </div>
    <button class="btn btn-primary" @onclick="RefreshInventory">
        <i class="fa-solid fa-rotate me-1"></i> Retry
    </button>
} else if (_inventoryResponse != null) {

    @* ── Header with summary stats ── *@
    @PageHeader(true)

    @* ── Summary cards (clickable → switch to relevant tab) ── *@
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-2 mb-3">
        <FreeCICD_App_UI_StatTile Value="@_inventoryResponse.Summary.ProjectCount.ToString()" Label="Projects" ColorClass="text-primary"
                OnClick='() => SetActiveTab("projects")' Title="View Projects tab" />
        <FreeCICD_App_UI_StatTile Value="@_inventoryResponse.Summary.RepoCount.ToString()" Label="Repos" ColorClass="text-info"
                OnClick='() => SetActiveTab("projects")' Title="View Projects tab" />
        <FreeCICD_App_UI_StatTile Value="@_inventoryResponse.Summary.CsprojCount.ToString()" Label=".csproj Files" ColorClass="text-secondary"
                OnClick='() => SetActiveTab("frameworks")' Title="View Frameworks tab" />
        <FreeCICD_App_UI_StatTile Value="@_inventoryResponse.Summary.TotalPackageRefs.ToString()" Label="Package Refs" ColorClass="text-primary"
                OnClick='() => SetActiveTab("packages")' Title="View Packages tab" />
        <FreeCICD_App_UI_StatTile Value="@_inventoryResponse.Summary.UniquePackageCount.ToString()" Label="Unique Packages" ColorClass="text-warning"
                OnClick='() => SetActiveTab("packages")' Title="View Packages tab" />
        <FreeCICD_App_UI_StatTile Value="@(_inventoryResponse.ElapsedSeconds.ToString("F1") + "s")" Label="Scan Time" ColorClass="text-success" />
    </div>

    @* ── Search and filter bar ── *@
    <div class="d-flex flex-wrap gap-2 mb-2 align-items-center">
        <div class="input-group" style="max-width: 350px;">
            <span class="input-group-text"><i class="fa-solid fa-search"></i></span>
            <input type="text" class="form-control" placeholder="Search packages, versions, projects..."
                    @bind="_searchTerm" @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(_searchTerm)) {
                <button class="btn btn-outline-secondary" @onclick="() => _searchTerm = string.Empty">
                    <i class="fa-solid fa-times"></i>
                </button>
            }
        </div>

        @if (_inventoryResponse.Summary.TargetFrameworks.Count > 0) {
            <select class="form-select" style="max-width: 220px;" @bind="_selectedFramework">
                <option value="">All Frameworks</option>
                @foreach (var fw in _inventoryResponse.Summary.TargetFrameworks) {
                    <option value="@fw">@fw (@GetFrameworkCsprojCount(fw))</option>
                }
            </select>
        }

        <div class="form-check ms-2">
            <input class="form-check-input" type="checkbox" id="multiVersionOnly" @bind="_multiVersionOnly" />
            <label class="form-check-label" for="multiVersionOnly">
                <span class="badge bg-warning text-dark">Version conflicts only</span>
            </label>
        </div>
    </div>

    @* ── Results count indicator ── *@
    @if (!string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_selectedFramework) || _multiVersionOnly) {
        <div class="text-muted small mb-2">
            <i class="fa-solid fa-filter me-1"></i>
            @if (_activeTab == "packages") {
                <span>Showing @_filteredPackages.Count of @TotalPackageCount packages</span>
            } else if (_activeTab == "projects") {
                <span>Showing @_filteredProjects.Count of @TotalProjectCount projects</span>
            } else {
                <span>Showing @_frameworkGroups.Count of @TotalFrameworkCount frameworks</span>
            }
            <button class="btn btn-link btn-sm p-0 ms-2" @onclick="() => { _searchTerm = string.Empty; _selectedFramework = string.Empty; _multiVersionOnly = false; }">
                <i class="fa-solid fa-times me-1"></i>Clear filters
            </button>
        </div>
    }

    @* ── Tab navigation ── *@
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "packages" ? "active" : "")" @onclick='() => SetActiveTab("packages")'>
                <i class="fa-solid fa-box me-1"></i> Packages (@TabCount("packages"))
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "projects" ? "active" : "")" @onclick='() => SetActiveTab("projects")'>
                <i class="fa-solid fa-folder-tree me-1"></i> Projects (@TabCount("projects"))
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "frameworks" ? "active" : "")" @onclick='() => SetActiveTab("frameworks")'>
                <i class="fa-solid fa-layer-group me-1"></i> Frameworks (@TabCount("frameworks"))
            </button>
        </li>
    </ul>

    @* TAB: Package Summary (sortable, expandable drill-down) *@
    @if (_activeTab == "packages") {
        <div class="table-responsive">
            <table class="table table-sm">
                <thead class="table-light">
                    <tr>
                        <th class="pointer user-select-none" @onclick='() => SortPackages("name")'>
                            Package <i class="fa-solid @_sort.IconClass("name") ms-1 text-muted" style="font-size: 0.75em;"></i>
                        </th>
                        <th class="pointer user-select-none" @onclick='() => SortPackages("versions")'>
                            Version(s) <i class="fa-solid @_sort.IconClass("versions") ms-1 text-muted" style="font-size: 0.75em;"></i>
                        </th>
                        <th class="text-end pointer user-select-none" style="width: 80px;" @onclick='() => SortPackages("uses")'>
                            Uses <i class="fa-solid @_sort.IconClass("uses") ms-1 text-muted" style="font-size: 0.75em;"></i>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pkg in _filteredPackages) {
                        var isExpanded = _expandedPackages.Contains(pkg.Name);
                        <tr @key="pkg.Name" @onclick="() => Helpers.ToggleSet(_expandedPackages, pkg.Name)" class="pointer @(isExpanded ? "table-active" : "")">
                            <td>
                                <i class="fa-solid @(isExpanded ? "fa-chevron-down" : "fa-chevron-right") me-1 text-muted" style="width: 14px; font-size: 0.75em;"></i>
                                @if (pkg.HasMultipleVersions) {
                                    <i class="fa-solid fa-triangle-exclamation text-warning me-1" title="Multiple versions detected"></i>
                                }
                                <span class="@(pkg.HasMultipleVersions ? "fw-bold" : "")">@pkg.Name</span>
                                <a href="https://www.nuget.org/packages/@pkg.Name" target="_blank" rel="noopener" class="ms-1 text-muted"
                                        @onclick:stopPropagation="true" title="View on NuGet.org">
                                    <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 0.7em;"></i>
                                </a>
                            </td>
                            <td>
                                @foreach (var version in pkg.Versions) {
                                    <span class="badge @VersionBadgeClass(pkg.HasMultipleVersions) me-1">@version</span>
                                }
                            </td>
                            <td class="text-end text-muted">@pkg.UsageCount</td>
                        </tr>
                        @if (isExpanded) {
                            var usages = GetPackageUsages(pkg.Name);
                            var versionClass = VersionBadgeClass(pkg.HasMultipleVersions);
                            <tr @key="@(pkg.Name + "/usages")">
                                <td colspan="3" class="p-0">
                                    <div class="bg-light border-top px-3 py-2">
                                        <div class="small fw-semibold text-muted mb-1">
                                            <i class="fa-solid fa-location-dot me-1"></i>
                                            Used in @usages.Count location@(usages.Count != 1 ? "s" : ""):
                                        </div>
                                        <table class="table table-sm table-borderless mb-0 small">
                                            <thead>
                                                <tr class="text-muted">
                                                    <th style="width: 160px;">Project</th>
                                                    <th style="width: 160px;">Repo</th>
                                                    <th style="width: 120px;">Branch</th>
                                                    <th>.csproj</th>
                                                    <th style="width: 100px;">Version</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var u in usages) {
                                                    <tr>
                                                        <td class="text-muted">
                                                            <i class="fa-solid fa-folder text-warning me-1" style="font-size: 0.8em;"></i>@u.Project
                                                        </td>
                                                        <td class="text-muted">
                                                            <i class="fa-solid fa-code-branch text-info me-1" style="font-size: 0.8em;"></i>@u.Repo
                                                        </td>
                                                        <td class="text-muted">
                                                            <i class="fa-solid fa-code-fork me-1" style="font-size: 0.8em;"></i>@u.Branch
                                                        </td>
                                                        <td>
                                                            <i class="fa-regular fa-file-code me-1 text-secondary" style="font-size: 0.8em;"></i>
                                                            @u.CsprojPath
                                                            @if (!string.IsNullOrEmpty(u.Framework)) {
                                                                <span class="badge bg-secondary ms-1" style="font-size: 0.65em;">@u.Framework</span>
                                                            }
                                                        </td>
                                                        <td><span class="badge @versionClass" style="font-size: 0.8em;">@u.Version</span></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_filteredPackages.Count == 0) {
            <div class="text-muted text-center py-4">
                <i class="fa-solid fa-box-open fa-2x mb-2 d-block"></i>
                No packages match the current filters.
            </div>
        }
    }

    @* TAB: Project Tree (branch + csproj toggles) *@
    @if (_activeTab == "projects") {
        <div class="mb-2">
            <button class="btn btn-outline-secondary btn-sm me-1" @onclick="ExpandAll">
                <i class="fa-solid fa-expand me-1"></i> Expand All
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="CollapseAll">
                <i class="fa-solid fa-compress me-1"></i> Collapse All
            </button>
        </div>

        @foreach (var project in _filteredProjects) {
            var isProjectExpanded = _expandedProjects.Contains(project.Id);
            var projCounts = _projectCounts.TryGetValue(project.Id, out var counts) ? counts : (Csproj: 0, PackageRefs: 0);
            var projCsprojCount = projCounts.Csproj;
            var projPackageCount = projCounts.PackageRefs;

            <div class="card mb-2" @key="project.Id">
                <div class="card-header py-2 d-flex justify-content-between align-items-center pointer" @onclick="() => Helpers.ToggleSet(_expandedProjects, project.Id)">
                    <div>
                        <i class="fa-solid @(isProjectExpanded ? "fa-chevron-down" : "fa-chevron-right") me-2 text-muted" style="width: 16px;"></i>
                        <i class="fa-solid fa-folder text-warning me-1"></i>
                        <strong>@project.Name</strong>
                        <span class="text-muted ms-2">
                            @project.Repos.Count repo@(project.Repos.Count != 1 ? "s" : ""),
                            @projCsprojCount .csproj,
                            @projPackageCount pkg ref@(projPackageCount != 1 ? "s" : "")
                        </span>
                    </div>
                </div>

                @if (isProjectExpanded) {
                    <div class="card-body py-2 ps-4">
                        @* Repos, branches, .csproj files and packages are sorted once when the inventory loads. *@
                        @foreach (var repo in project.Repos) {
                            var repoKey = project.Id + "/" + repo.Id;
                            var isRepoExpanded = _expandedRepos.Contains(repoKey);

                            <div class="mb-1">
                                <div class="py-1 pointer" @onclick="() => Helpers.ToggleSet(_expandedRepos, repoKey)">
                                    <i class="fa-solid @(isRepoExpanded ? "fa-chevron-down" : "fa-chevron-right") me-2 text-muted" style="width: 16px;"></i>
                                    <i class="fa-solid fa-code-branch text-info me-1"></i>
                                    <span class="fw-semibold">@repo.Name</span>
                                    <span class="text-muted ms-1">(@repo.Branches.Count branch@(repo.Branches.Count != 1 ? "es" : ""))</span>
                                </div>

                                @if (isRepoExpanded) {
                                    <div class="ps-4">
                                        @foreach (var branch in repo.Branches) {
                                            var branchKey = repoKey + "/" + branch.Name;
                                            var isBranchExpanded = _expandedBranches.Contains(branchKey);
                                            var branchCsprojCount = branch.CsprojFiles.Count;

                                            <div class="mb-1">
                                                <div class="py-1 pointer" @onclick="() => Helpers.ToggleSet(_expandedBranches, branchKey)">
                                                    <i class="fa-solid @(isBranchExpanded ? "fa-chevron-down" : "fa-chevron-right") me-2 text-muted" style="width: 14px; font-size: 0.85em;"></i>
                                                    <i class="fa-solid fa-code-fork me-1 text-muted"></i>
                                                    <span>@branch.Name</span>
                                                    <span class="text-muted ms-1">(@branchCsprojCount .csproj)</span>
                                                </div>

                                                @if (isBranchExpanded) {
                                                    <div class="ps-4">
                                                        @foreach (var csproj in branch.CsprojFiles) {
                                                            var csprojKey = branchKey + "/" + csproj.Path;
                                                            var isCsprojExpanded = _expandedCsproj.Contains(csprojKey);

                                                            <div class="mb-1">
                                                                <div class="py-1 pointer" @onclick="() => Helpers.ToggleSet(_expandedCsproj, csprojKey)">
                                                                    <i class="fa-solid @(isCsprojExpanded ? "fa-chevron-down" : "fa-chevron-right") me-2 text-muted" style="width: 14px; font-size: 0.8em;"></i>
                                                                    <i class="fa-regular fa-file-code me-1 text-secondary"></i>
                                                                    <span>@csproj.Path</span>
                                                                    @if (!string.IsNullOrEmpty(csproj.TargetFramework)) {
                                                                        <span class="badge bg-secondary ms-1">@csproj.TargetFramework</span>
                                                                    }
                                                                    @if (csproj.Packages.Count > 0) {
                                                                        <span class="text-muted ms-1">(@csproj.Packages.Count pkg@(csproj.Packages.Count != 1 ? "s" : ""))</span>
                                                                    }
                                                                </div>

                                                                @if (isCsprojExpanded && csproj.Packages.Count > 0) {
                                                                    <div class="ps-4 pb-1">
                                                                        @foreach (var pkg in csproj.Packages) {
                                                                            var isConflict = _conflictingPackages.Contains(pkg.Name);
                                                                            <div class="small">
                                                                                @if (isConflict) {
                                                                                    <i class="fa-solid fa-triangle-exclamation text-warning me-1" style="font-size: 0.8em;" title="Version conflict across org"></i>
                                                                                }
                                                                                <span class="@(isConflict ? "fw-semibold" : "text-muted")">@pkg.Name</span>
                                                                                <span class="badge @VersionBadgeClass(isConflict) ms-1" style="font-size: 0.7em;">@pkg.Version</span>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (_filteredProjects.Count == 0) {
            <div class="text-muted text-center py-4">
                <i class="fa-solid fa-folder-open fa-2x mb-2 d-block"></i>
                No projects match the current filters.
            </div>
        }
    }

    @* TAB: Framework Summary (collapsible, filtered) *@
    @if (_activeTab == "frameworks") {
        @foreach (var fwGroup in _frameworkGroups) {
            var isFrameworkExpanded = _expandedFrameworks.Contains(fwGroup.Key);
            var fwCount = fwGroup.Count();
            <div class="card mb-2" @key="fwGroup.Key">
                <div class="card-header py-2 d-flex justify-content-between align-items-center pointer" @onclick="() => Helpers.ToggleSet(_expandedFrameworks, fwGroup.Key)">
                    <div>
                        <i class="fa-solid @(isFrameworkExpanded ? "fa-chevron-down" : "fa-chevron-right") me-2 text-muted" style="width: 16px;"></i>
                        <span class="badge bg-secondary me-2">@fwGroup.Key</span>
                        <span class="text-muted">@fwCount .csproj file@(fwCount != 1 ? "s" : "")</span>
                    </div>
                </div>
                @if (isFrameworkExpanded) {
                    <div class="card-body py-2">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 200px;">Project</th>
                                        <th style="width: 200px;">Repo</th>
                                        <th>.csproj Path</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in fwGroup.OrderBy(x => x.Project).ThenBy(x => x.Repo)) {
                                        <tr>
                                            <td>
                                                <i class="fa-solid fa-folder text-warning me-1" style="font-size: 0.85em;"></i>
                                                <span class="text-muted">@item.Project</span>
                                            </td>
                                            <td>
                                                <i class="fa-solid fa-code-branch text-info me-1" style="font-size: 0.85em;"></i>
                                                <span class="text-muted">@item.Repo</span>
                                            </td>
                                            <td>
                                                <i class="fa-regular fa-file-code me-1 text-secondary" style="font-size: 0.85em;"></i>
                                                @item.Csproj
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }

        @if (_frameworkGroups.Count == 0) {
            <div class="text-muted text-center py-4">
                <i class="fa-solid fa-layer-group fa-2x mb-2 d-block"></i>
                No framework data matches the current filters.
            </div>
        }
    }

    @* ── Footer with scan time ── *@
    @if (_inventoryResponse.LastScannedUtc.HasValue) {
        <div class="text-muted small mt-3">
            <i class="fa-regular fa-clock me-1"></i>
            Last scanned: @Helpers.FormatDateTime(_inventoryResponse.LastScannedUtc)
            — @_inventoryResponse.ElapsedSeconds.ToString("F1")s
        </div>
    }
}
