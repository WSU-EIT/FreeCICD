@* Pipeline Filter Bar Component *@
@* Provides search, status/result/repo/trigger filters, and quick filter options *@

<div class="pipeline-filter-bar mb-3">
    <div class="row g-2 align-items-center">
        @* Search Input *@
        <div class="col-12 col-md-4 col-lg-3">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                    <i class="fa fa-search text-muted"></i>
                </span>
                <input type="text"
                        class="form-control border-start-0"
                        placeholder="Search pipelines..."
                        @bind="_search"
                        @bind:event="oninput"
                        @bind:after="Notify" />
                @if (!string.IsNullOrWhiteSpace(_search)) {
                    <button class="btn btn-outline-secondary border-start-0" type="button" @onclick="ClearSearch">
                        <i class="fa fa-times"></i>
                    </button>
                }
            </div>
        </div>

        @* Status Filter *@
        <div class="col-6 col-md-2">
            <select class="form-select" @bind="_status" @bind:after="Notify">
                <option value="">All Statuses</option>
                <option value="completed">Completed</option>
                <option value="inprogress">In Progress</option>
                <option value="queued">Queued</option>
                <option value="notstarted">Not Started</option>
            </select>
        </div>

        @* Result Filter *@
        <div class="col-6 col-md-2">
            <select class="form-select" @bind="_result" @bind:after="Notify">
                <option value="">All Results</option>
                <option value="succeeded">Succeeded</option>
                <option value="failed">Failed</option>
                <option value="partiallysucceeded">Partial</option>
                <option value="canceled">Canceled</option>
            </select>
        </div>

        @* Trigger Filter *@
        <div class="col-6 col-md-2">
            <select class="form-select" @bind="_trigger" @bind:after="Notify">
                <option value="">All Triggers</option>
                <option value="manual">👤 Manual</option>
                <option value="codepush">⚡ Code Push (CI)</option>
                <option value="scheduled">⏰ Scheduled</option>
                <option value="pullrequest">🔀 Pull Request</option>
                <option value="pipelinecompletion">🔗 Pipeline</option>
                <option value="other">Other</option>
            </select>
        </div>

        @* Repository Filter *@
        @if (Repositories?.Any() == true) {
            <div class="col-6 col-md-2">
                <select class="form-select" @bind="_repository" @bind:after="Notify">
                    <option value="">All Repos</option>
                    @foreach (var repo in Repositories) {
                        <option value="@repo">@repo</option>
                    }
                </select>
            </div>
        }

        @* Failed Only Checkbox *@
        <div class="col-auto">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="failedOnlyCheck"
                        @bind="_failedOnly" @bind:after="Notify" />
                <label class="form-check-label text-nowrap" for="failedOnlyCheck">
                    <i class="fa fa-times-circle text-danger me-1"></i>
                    Failed Only
                </label>
            </div>
        </div>

        @* Clear Filters Button *@
        @if (ActiveFilterCount > 0) {
            <div class="col-auto">
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearAllFilters">
                    <i class="fa fa-filter me-1"></i>
                    Clear Filters
                    <span class="badge bg-primary ms-1">@ActiveFilterCount</span>
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public DashboardView.FilterState Filters { get; set; } = new();
    [Parameter] public EventCallback<DashboardView.FilterState> FiltersChanged { get; set; }
    [Parameter] public List<string>? Repositories { get; set; }

    // Local copies the inputs bind to: binding to the parameters lost typed or pasted text whenever the page re-rendered.
    private string _search = "", _status = "", _result = "", _repository = "", _trigger = "";
    private bool _failedOnly;
    private DashboardView.FilterState? _applied;

    protected override void OnParametersSet()
    {
        // Only take the parent's value when it is a new one (a load of saved preferences), not on every re-render.
        if (!ReferenceEquals(Filters, _applied)) {
            _applied = Filters;
            (_search, _status, _result, _repository, _trigger, _failedOnly) =
                (Filters.SearchTerm, Filters.Status, Filters.Result, Filters.Repository, Filters.Trigger, Filters.FailedOnly);
        }
    }

    private int ActiveFilterCount =>
        new[] { _search, _status, _result, _repository, _trigger }.Count(v => !string.IsNullOrWhiteSpace(v)) + (_failedOnly ? 1 : 0);

    private async Task Notify()
    {
        _applied = new DashboardView.FilterState(_search ?? "", _status ?? "", _result ?? "", _repository ?? "", _trigger ?? "", _failedOnly);
        await FiltersChanged.InvokeAsync(_applied);
    }

    private async Task ClearSearch()
    {
        _search = "";
        await Notify();
    }

    private async Task ClearAllFilters()
    {
        (_search, _status, _result, _repository, _trigger, _failedOnly) = ("", "", "", "", "", false);
        await Notify();
    }
}
