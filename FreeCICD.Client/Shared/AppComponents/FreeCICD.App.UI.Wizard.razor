@* FreeCICD Pipeline Wizard Component, rendered by Pages/App/FreeCICD.App.Pages.Wizard.razor. *@

@inherits AppLoadingPageBase

@code {
    protected override string PageName => AppViews.Wizard;
    protected override Task LoadAsync() => LoadData();

    // Import state management
    protected int? _importPipelineId = null;
    protected bool _isImporting = false;
    protected bool _importCompleted = false;
    protected string _importErrorMessage = string.Empty;
    protected DataObjects.ParsedPipelineSettings? _parsedSettings = null;
    protected int _importConfidenceScore = 0;
    
    // Track which fields were populated by import (for visual highlighting)
    protected HashSet<string> _importedFields = new();

    // Import from public repo modal
    protected FreeCICD_App_UI_Import? _importPublicRepoModal;

    protected string LogoUrl {
        get {
            if (Model.Tenant.TenantSettings.Logo.HasValue && Model.Tenant.TenantSettings.Logo != Guid.Empty) {
                return Model.ApplicationUrl + "File/View/" + ((Guid)Model.Tenant.TenantSettings.Logo).ToString();
            } else {
                return String.Empty;
            }
        }
    }

    protected async Task LoadData()
    {
        await MyLoadDataAsync();
        _loading = false;
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        CheckForImportParameter();
    }
}

@if (Model.Tenant.TenantSettings.LogoIncludedOnHomePage && !String.IsNullOrWhiteSpace(LogoUrl)) {
    <div class="home-page-logo-container">
        <img src="@LogoUrl" class="logo-homepage" />
    </div>
}

@if (_loading) {
    <LoadingMessage />
} else {
        <h1 class="page-title">
            @if (!String.IsNullOrWhiteSpace(Model.Tenant.TenantSettings.AppIcon)) {
                <i>@((MarkupString)Model.Tenant.TenantSettings.AppIcon)</i>
            }
            <Language Tag="Welcome" ReplaceSpaces="true" /> @Model.User.FirstName
        </h1>

            <div class="container-fluid px-0" style="max-width: 1000px;">
                
                @* Import Banner - Shows when importing from existing pipeline *@
                @if (ShowImportBanner)
                {
                    <div class="@ImportBannerClass mb-3">
                        <div class="d-flex align-items-center">
                            @if (_isImporting)
                            {
                                <div class="spinner-border spinner-border-sm me-2" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(_importErrorMessage))
                            {
                                <i class="fa fa-exclamation-triangle me-2"></i>
                            }
                            else if (_importCompleted)
                            {
                                <i class="fa fa-check-circle me-2"></i>
                            }
                            <span>@ImportStatusMessage</span>
                            @if (_importCompleted && _parsedSettings != null)
                            {
                                <span class="ms-auto badge bg-secondary">
                                    Confidence: @_importConfidenceScore%
                                </span>
                            }
                        </div>
                    </div>
                }

                @* Quick Actions - Import from Public Repo *@
                <div class="d-flex justify-content-end mb-3">
                    <button class="btn btn-outline-primary btn-sm" @onclick="ShowImportPublicRepoModal">
                        <i class="fa fa-cloud-download-alt me-1"></i>
                        Import from GitHub/GitLab
                    </button>
                </div>

                @* Wizard Stepper - Horizontal step indicator *@
                @RenderStepper()

                @* Selection Summary - Shows previous selections inline *@
                @* Show when there are selections OR when past first step (to handle both import and manual flow) *@
                @* Built once per render: the visibility test and the summary both need it. *@
                @{ var selectionSummary = GetSelectionSummary(); }
                @if (selectionSummary.Any(s => !string.IsNullOrWhiteSpace(s.Value)) || currentStep > FirstVisibleStep)
                {
                    @RenderSummary(selectionSummary)
                }

                @* Main Wizard Card *@
                <div class="card shadow-sm border-0">
                    @* Every step but Completed shares one header layout *@
                    @{ var wizardStep = CurrentWizardStep; }
                    @if (wizardStep.Name != DataObjects.StepNameList.Completed)
                    {
                        @RenderStepHeader(wizardStep.Title,
                            stepNumber: currentStep + 1 - FirstVisibleStep,
                            showStartOver: currentStep > FirstVisibleStep,
                            showBack: wizardStep.ShowBack,
                            showNext: !wizardStep.IsSave,
                            showSave: wizardStep.IsSave,
                            nextDisabled: wizardStep.NextBlocked?.Invoke() ?? false,
                            isDisabled: _loading || (wizardStep.IsSave && (_isPreviewLoading || _isSaving)),
                            step: wizardStep)
                    }
                    else if (_isSaving)
                    {
                        @RenderStepHeader("Saving Pipeline...", headerClass: "bg-warning text-dark", showSpinner: true, spinnerText: "Saving...", infoText: "Please don't navigate away")
                    }
                    else if (!string.IsNullOrWhiteSpace(_saveErrorMessage))
                    {
                        @RenderStepHeader("Save Failed", headerClass: "bg-danger text-white", badgeIcon: "fa-times", badgeClass: "bg-light text-danger", showBack: true, showStartOver: true)
                    }
                    else if (_saveCompleted)
                    {
                        @RenderStepHeader("Completed", headerClass: "bg-success text-white", badgeIcon: "fa-check", badgeClass: "bg-light text-success", showCreateAnother: true)
                    }
                    else
                    {
                        @RenderStepHeader("Processing...", headerClass: "bg-secondary text-white")
                    }

                    <div class="card-body p-4">
                        @{
                            switch (wizardStep.Name) {
                                case DataObjects.StepNameList.SelectPAT:
                                    @RenderStepPAT()
                                    break;

                                case DataObjects.StepNameList.SelectProject:
                                    @RenderSelect("Project:", "-- Select Project --",
                                        SelectOptionsByText(DevopsProjectInfos, p => p.ProjectId, p => p.ProjectName),
                                        SelectedProjectId, EventCallback.Factory.Create<ChangeEventArgs>(this, ProjectChangedWizard))
                                    break;

                                case DataObjects.StepNameList.SelectRepository:
                                    @RenderSelect("Repository:", "-- Select Repository --",
                                        SelectOptionsByText(SelectedProjectInfo?.GitRepos, r => r.RepoId, r => r.RepoName),
                                        SelectedRepoId, EventCallback.Factory.Create<ChangeEventArgs>(this, RepoChangedWizard))
                                    break;

                                case DataObjects.StepNameList.SelectBranch:
                                    @RenderSelect("Branch:", "-- Select Branch --",
                                        SelectOptionsByText(SelectedRepoInfo?.GitBranches, b => b.BranchName, b => b.BranchName),
                                        SelectedBranch, EventCallback.Factory.Create<ChangeEventArgs>(this, BranchChangedWizard))
                                    break;

                                case DataObjects.StepNameList.SelectCsprojFile:
                                    @RenderStepCsproj()
                                    break;

                                case DataObjects.StepNameList.EnvironmentSettings:
                                    <FreeCICD_App_UI_Wizard_StepEnvironments EnvironmentOptions="@GlobalSettings.App.EnvironmentOptions"
                                            EnvSettings="@EnvSettings"
                                            IsDisabled="@_loading"
                                            ImportedFields="@_importedFields"
                                            VerifyAfterDeploy="@VerifyAfterDeploy"
                                            VerifyAfterDeployChanged="@(on => { VerifyAfterDeploy = on; StateHasChanged(); })"
                                            ShowGatherServerInfo="@IsSelfProject"
                                            GatherServerInfo="@GatherServerInfo"
                                            GatherServerInfoChanged="@(on => { GatherServerInfo = on; StateHasChanged(); })"
                                            GetIisOptionsFunc="@GetIisOptions"
                                            OnEnvironmentChanged="@EnvironmentChangedWizard"
                                            OnDeploymentTypeChanged="@EnvironmentDeploymentTypeChangedWizard"
                                            OnIisFieldChanged="@ApplyIisField" />
                                    break;

                                case DataObjects.StepNameList.SelectPipelineSelection:
                                    @RenderStepPipeline()
                                    break;

                                case DataObjects.StepNameList.YAMLPreviewAndSave:
                                    @RenderStepPreview()
                                    break;

                                case DataObjects.StepNameList.Completed:
                                    <FreeCICD_App_UI_Wizard_StepCompleted IsSaving="@_isSaving"
                                            SaveCompleted="@_saveCompleted"
                                            SaveErrorMessage="@_saveErrorMessage"
                                            LastSavedPipelineDefinition="@LastSavedPipelineDefinition"
                                            SelectedProjectInfo="@SelectedProjectInfo"
                                            SelectedBranchInfo="@SelectedBranchInfo"
                                            EnvironmentSettings="@EnvSettings" />
                                    break;
                            }
                        }

                        @* Loading indicator and messages *@
                        @RenderLoadingIndicator()
                    </div>
                </div>
            </div>

            @* Import from Public Repo Modal *@
            <FreeCICD_App_UI_Import @ref="_importPublicRepoModal" OnImportComplete="@OnPublicRepoImportComplete" />
}

@code {
    protected async Task MyLoadDataAsync()
    {
        if (Model.LoggedIn) {
            _hidePAT = true;
            currentStep = 1;
            DevOpsPAT = DataObjects.DevOpsPlaceholders.Pat;
            OrgName = DataObjects.DevOpsPlaceholders.OrgName;
            await PATandOrgNameChangedWizard();
            await PrefetchIISDataIfNeeded();
            
            // Process import if ?import= parameter was provided
            await ProcessImportIfNeeded();
            
            StateHasChanged();
        } else {
            OrgName = string.Empty;
            DevOpsPAT = string.Empty;
            currentStep = 0;
            await PrefetchIISDataIfNeeded();
            StateHasChanged();
        }
    }

    private bool _hidePAT = false;
    private int currentStep = 0;
    private string? SelectedProjectId = string.Empty;
    private string? SelectedRepoId = string.Empty;
    private string? SelectedBranch = string.Empty;
    private string? SelectedCsprojPath = string.Empty;
    private string? NewPipelineName = string.Empty;
    private int? SelectedPipelineId = 0;
    private string ExistingYamlContent = string.Empty;
    private string NewYamlContent { get; set; } = string.Empty;
    private DataObjects.DevopsPipelineDefinition? LastSavedPipelineDefinition { get; set; } = null;
    private string DevOpsPAT { get; set; } = string.Empty;
    private string OrgName { get; set; } = string.Empty;
    private Dictionary<GlobalSettings.EnvironmentType, DataObjects.EnvSetting> EnvSettings = new();
    // On by default; the server ignores it for a caller using their own PAT (the report key is this server's).
    private bool VerifyAfterDeploy = true;
    // FreeCICD's own pipeline only: the gather stages. Off until the box is ticked or an existing FreeCICD pipeline carries it.
    private bool GatherServerInfo = false;
    private bool IsSelfProject => DataObjects.IsAtlasSelfProject(SelectedProjectInfo?.ProjectName) && DataObjects.IsAtlasSelfProject(SelectedRepoInfo?.RepoName);

    /// <summary>
    /// One wizard step: its name (a DataObjects.StepNameList value), the stepper label, the header title, the value
    /// the stepper shows under it, and the entry it adds to "Your Selections" (null for none).
    /// </summary>
    private sealed record WizardStep(string Name, string ShortName, string Title, Func<string> StepperValue)
    {
        /// <summary>The step whose header saves instead of moving on.</summary>
        public bool IsSave { get; init; }
        /// <summary>What Next does; NextStep(Name) when null.</summary>
        public Func<Task>? Next { get; init; }
        /// <summary>True while the step's Next button must stay disabled.</summary>
        public Func<bool>? NextBlocked { get; init; }
        public bool ShowBack { get; init; } = true;
        public Func<SelectionItem?>? Summary { get; init; }
    }

    private List<WizardStep>? _steps;

    /// <summary>The wizard's steps in order; the index into this list is currentStep.</summary>
    private List<WizardStep> Steps => _steps ??= BuildSteps();

    private WizardStep CurrentWizardStep => Steps[currentStep];

    /// <summary>The first step shown: the credentials step is skipped for a signed-in user.</summary>
    private int FirstVisibleStep => _hidePAT ? 1 : 0;

    private List<WizardStep> BuildSteps() => [
        new WizardStep(DataObjects.StepNameList.SelectPAT, "Credentials", "Azure DevOps Credentials",
            () => !string.IsNullOrWhiteSpace(OrgName) ? OrgName : "") {
            NextBlocked = () => string.IsNullOrWhiteSpace(DevOpsPAT) || string.IsNullOrWhiteSpace(OrgName),
            Next = PATandOrgNameChangedWizard,
            ShowBack = false,
        },
        new WizardStep(DataObjects.StepNameList.SelectProject, "Project", "Select Project",
            () => SelectedProjectInfo?.ProjectName ?? "") {
            Summary = () => Selection("Project", SelectedProjectInfo?.ProjectName),
            NextBlocked = () => string.IsNullOrEmpty(SelectedProjectId),
            ShowBack = false,
        },
        new WizardStep(DataObjects.StepNameList.SelectRepository, "Repository", "Select Repository",
            () => SelectedRepoInfo?.RepoName ?? "") {
            Summary = () => Selection("Repository", SelectedRepoInfo?.RepoName),
            NextBlocked = () => string.IsNullOrEmpty(SelectedRepoId),
        },
        new WizardStep(DataObjects.StepNameList.SelectBranch, "Branch", "Select Branch",
            () => SelectedBranchInfo?.BranchName ?? "") {
            Summary = () => Selection("Branch", SelectedBranchInfo?.BranchName),
            NextBlocked = () => string.IsNullOrEmpty(SelectedBranch),
        },
        new WizardStep(DataObjects.StepNameList.SelectCsprojFile, ".csproj", "Select .csproj File",
            () => !string.IsNullOrWhiteSpace(SelectedCsprojPath) ? System.IO.Path.GetFileName(SelectedCsprojPath) : "") {
            Summary = () => Selection(".csproj File", SelectedCsprojPath),
        },
        new WizardStep(DataObjects.StepNameList.EnvironmentSettings, "Environments", "Environment Settings",
            () => EnvironmentList) {
            Summary = () => Selection("Environments", EnvironmentList),
        },
        new WizardStep(DataObjects.StepNameList.SelectPipelineSelection, "Pipeline", "Pipeline Selection",
            () => SelectedPipelineInfo?.Name ?? NewPipelineName ?? "") {
            Summary = () => SelectedPipelineInfo != null
                ? new SelectionItem { Label = "Pipeline", Value = SelectedPipelineInfo.Name ?? "" }
                : Selection("New Pipeline", NewPipelineName),
            NextBlocked = () => SelectedPipelineId <= 0 && string.IsNullOrWhiteSpace(NewPipelineName),
        },
        new WizardStep(DataObjects.StepNameList.YAMLPreviewAndSave, "Preview", "YAML Preview & Save",
            () => !string.IsNullOrWhiteSpace(NewYamlContent) ? "Ready" : "") {
            IsSave = true,
        },
        new WizardStep(DataObjects.StepNameList.Completed, "Done", DataObjects.StepNameList.Completed, () => "?"),
    ];

    /// <summary>The ticked environments, comma separated; empty when none.</summary>
    private string EnvironmentList => string.Join(", ", EnvSettings.Keys.Select(k => k.ToString()));

    /// <summary>A "Your Selections" entry, or null when the value is blank.</summary>
    private static SelectionItem? Selection(string label, string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : new SelectionItem { Label = label, Value = value };

    private List<DataObjects.DevopsProjectInfo> DevopsProjectInfos { get; set; } = new();
    private List<DataObjects.DevopsPipelineDefinition> DevopsPipelineDefinitions { get; set; } = new();
    private List<LoadingMessageItem> _loadingMessages = new();
    private bool _isPreviewLoading = false;
    private bool _isSaving = false;
    private bool _saveCompleted = false;
    private string _saveErrorMessage = string.Empty;

    // The objects behind the selected ids. Set by ResolveSelection whenever an id or a fetched list changes, so a
    // render reads them instead of searching the lists again.
    protected DataObjects.DevopsProjectInfo? SelectedProjectInfo { get; private set; }
    protected DataObjects.DevopsGitRepoInfo? SelectedRepoInfo { get; private set; }
    protected DataObjects.DevopsGitRepoBranchInfo? SelectedBranchInfo { get; private set; }
    protected DataObjects.DevopsPipelineDefinition? SelectedPipelineInfo => DevopsPipelineDefinitions?.FirstOrDefault(p => p.Id == SelectedPipelineId);

    /// <summary>Finds the selected project, repository and branch objects from the selected ids.</summary>
    private void ResolveSelection()
    {
        SelectedProjectInfo = DevopsProjectInfos?.FirstOrDefault(p => p.ProjectId == SelectedProjectId);
        SelectedRepoInfo = SelectedProjectInfo?.GitRepos.FirstOrDefault(r => r.RepoId == SelectedRepoId);
        SelectedBranchInfo = SelectedRepoInfo?.GitBranches.FirstOrDefault(b => b.BranchName == SelectedBranch);
    }

    /// <summary>The preview and save request, built from the current selections when it is sent.</summary>
    protected DataObjects.DevOpsPipelineRequest BuildPipelineRequest() => new DataObjects.DevOpsPipelineRequest {
            Pat = DevOpsPAT,
            OrgName = OrgName,
            ProjectId = SelectedProjectInfo?.ProjectId ?? "",
            RepoId = SelectedRepoInfo?.RepoId ?? "",
            Branch = SelectedBranch ?? "",
            YAMLFileName = SelectedPipelineInfo?.YamlFileName ?? "",
            PipelineId = SelectedPipelineId.GetValueOrDefault(0),
            PipelineName = SelectedPipelineId > 0 ? string.Empty : NewPipelineName ?? "",
            EnvironmentSettings = EnvSettings.ToDictionary(kvp => kvp.Key, kvp => kvp.Value),
            CsProjectFile = NormalizeCsprojPath(SelectedCsprojPath),
            ConnectionId = Helpers.CurrentConnectionId(),
            VerifyAfterDeploy = VerifyAfterDeploy,
            GatherServerInfo = GatherServerInfo && IsSelfProject
        };

    /// <summary>
    /// A DevOps endpoint URL: this browser's SignalR connection, the given query values, then the organization and
    /// PAT the wizard holds. Every wizard call to Azure DevOps is built here.
    /// </summary>
    private string DevOpsUrl(string endpoint, params (string Name, string? Value)[] query)
    {
        var url = new System.Text.StringBuilder(endpoint).Append(Helpers.ConnectionIdQuery());
        foreach (var (name, value) in query) {
            url.Append('&').Append(name).Append('=').Append(Uri.EscapeDataString(value ?? ""));
        }
        url.Append("&orgName=").Append(Uri.EscapeDataString(OrgName));
        url.Append("&pat=").Append(Uri.EscapeDataString(DevOpsPAT));
        return url.ToString();
    }

    /// <summary>
    /// Loads the selected project's pipeline definitions (nothing happens without a selected project). A failed call
    /// leaves an empty list, so another project's pipelines are never offered. With <paramref name="autoSelectSingle"/>,
    /// a project with exactly one pipeline has it selected.
    /// </summary>
    private async Task LoadPipelineDefinitionsAsync(bool autoSelectSingle)
    {
        if (SelectedProjectInfo == null) {
            return;
        }
        var results = await Helpers.GetOrPost<DataObjects.DevOpsResponse<List<DataObjects.DevopsPipelineDefinition>>>(
            DevOpsUrl(DataObjects.Endpoints.DevOps.GetDevOpsPipelines, ("projectId", SelectedProjectInfo.ProjectId)));
        DevopsPipelineDefinitions = LookupValue(results) ?? new List<DataObjects.DevopsPipelineDefinition>();
        if (autoSelectSingle && DevopsPipelineDefinitions.Count == 1) {
            SelectedPipelineId = DevopsPipelineDefinitions[0].Id;
        }
    }

    /// <summary>
    /// A lookup's value, or null after showing why it failed: the server's messages (a bad PAT, a missing scope), or
    /// the standard unknown error when no answer came back.
    /// </summary>
    private T? LookupValue<T>(DataObjects.DevOpsResponse<T>? response) where T : class
    {
        if (response == null) {
            Model.UnknownError();
            return null;
        }
        if (!response.ActionResponse.Result) {
            Model.ErrorMessages(response.ActionResponse.Messages);
            return null;
        }
        return response.Value;
    }

    private void AddLoadingMessage(string message)
    {
        _loadingMessages.Insert(0, new LoadingMessageItem { Message = message, Created = DateTime.UtcNow });
    }

    private void ClearLoadingMessages()
    {
        _loadingMessages = new();
        StateHasChanged();
    }

    private async Task NextStep(string? stepName = "")
    {
        ClearLoadingMessages();
        if (currentStep < Steps.Count - 1) { currentStep++; }

        switch (stepName) {
            case DataObjects.StepNameList.SelectProject:
                StateHasChanged();
                if (!string.IsNullOrWhiteSpace(SelectedProjectId)) {
                    try {
                        await LoadPipelineDefinitionsAsync(autoSelectSingle: true);
                    } finally { StateHasChanged(); }
                }
                break;

            case DataObjects.StepNameList.SelectPipelineSelection:
                _isPreviewLoading = true;
                StateHasChanged();
                if (!string.IsNullOrWhiteSpace(NewPipelineName) || SelectedPipelineId != null) {
                    ExistingYamlContent = string.Empty;
                    var pipeline = SelectedPipelineInfo;
                    if (pipeline != null && !string.IsNullOrEmpty(pipeline.YamlFileName)) {
                        var existing = await Helpers.GetOrPost<DataObjects.DevOpsResponse<string>>(DevOpsUrl(DataObjects.Endpoints.DevOps.GetDevOpsYmlFileContent,
                            ("filePath", pipeline.YamlFileName),
                            ("projectId", SelectedProjectInfo?.ProjectId),
                            ("repoId", SelectedRepoInfo?.RepoId),
                            ("branchName", SelectedBranchInfo?.BranchName)));
                        ExistingYamlContent = LookupValue(existing) ?? "";
                    } else { SelectedPipelineId = 0; ExistingYamlContent = ""; }
                    NewYamlContent = string.Empty;
                    StateHasChanged();
                    AddLoadingMessage("Generating YAML preview…");
                    StateHasChanged();
                    try {
                        var response = await Helpers.GetOrPost<DataObjects.DevOpsResponse<string>>($"{DataObjects.Endpoints.DevOps.PreviewDevOpsYmlFileContents}", BuildPipelineRequest());
                        var preview = LookupValue(response);
                        if (!string.IsNullOrWhiteSpace(preview)) { NewYamlContent = preview; AddLoadingMessage("Preview fetched successfully."); }
                        else { AddLoadingMessage("The preview could not be generated."); }
                    } finally { _isPreviewLoading = false; StateHasChanged(); }
                }
                break;

            case DataObjects.StepNameList.YAMLPreviewAndSave:
                // Reset save state
                _isSaving = true;
                _saveCompleted = false;
                _saveErrorMessage = string.Empty;
                LastSavedPipelineDefinition = null;
                StateHasChanged();
                
                try {
                    AddLoadingMessage("Saving pipeline… please don't navigate away.");
                    StateHasChanged();

                    var createOrUpdateResult = await Helpers.GetOrPost<DataObjects.DevopsPipelineDefinition>($"{DataObjects.Endpoints.DevOps.CreateOrUpdateDevOpsPipeline}", BuildPipelineRequest());

                    if (createOrUpdateResult == null) {
                        _saveErrorMessage = Helpers.Text("ErrorUnknown");
                        Model.UnknownError();
                    } else if (createOrUpdateResult.ActionResponse.Result && createOrUpdateResult.Id > 0) {
                        LastSavedPipelineDefinition = createOrUpdateResult;
                        _saveCompleted = true;
                        AddLoadingMessage("Pipeline created/updated successfully.");
                    } else {
                        // The completed step keeps showing why the save failed after the toast is dismissed.
                        _saveErrorMessage = createOrUpdateResult.ActionResponse.Messages.Count > 0
                            ? String.Join(" ", createOrUpdateResult.ActionResponse.Messages)
                            : Helpers.Text("ErrorUnknown");
                        Model.ErrorMessages(createOrUpdateResult.ActionResponse.Messages);
                    }
                }
                finally {
                    _isSaving = false;
                    StateHasChanged();
                }
                break;
        }
    }

    private void PrevStep() { ClearLoadingMessages(); if (currentStep > FirstVisibleStep) { currentStep--; StateHasChanged(); } }

    private async Task PATandOrgNameChangedWizard()
    {
        ClearLoadingMessages();
        StateHasChanged();
        try {
            var result = LookupValue(await Helpers.GetOrPost<DataObjects.DevOpsResponse<List<DataObjects.DevopsProjectInfo>>>(DevOpsUrl(DataObjects.Endpoints.DevOps.GetDevOpsProjects)));
            if (result != null && result.Any()) {
                DevopsProjectInfos = result.ToList();
                ResolveSelection();
                currentStep = 1;
                StateHasChanged();
                if (DevopsProjectInfos.Count == 1) { SelectedProjectId = DevopsProjectInfos[0].ProjectId; await ProjectChangedWizard(new ChangeEventArgs { Value = SelectedProjectId }); }
            } else { DevopsProjectInfos = new List<DataObjects.DevopsProjectInfo>(); ResolveSelection(); }
        } finally { StateHasChanged(); }
    }

    private async Task ProjectChangedWizard(ChangeEventArgs e)
    {
        ClearLoadingMessages();
        StateHasChanged();
        try {
            SelectedProjectId = e.Value?.ToString() ?? "";
            SelectedRepoId = "";
            SelectedBranch = "";
            ResolveSelection();
            if (SelectedProjectInfo != null) {
                var result = LookupValue(await Helpers.GetOrPost<DataObjects.DevOpsResponse<List<DataObjects.DevopsGitRepoInfo>>>(DevOpsUrl(DataObjects.Endpoints.DevOps.GetDevOpsRepos,
                    ("projectId", SelectedProjectInfo.ProjectId))));
                if (result != null && result.Any()) {
                    // Only the selected project keeps its repositories; the others are fetched again when chosen.
                    foreach (var project in DevopsProjectInfos) { project.GitRepos = project == SelectedProjectInfo ? result : new List<DataObjects.DevopsGitRepoInfo>(); }
                    if (result.Count == 1) { SelectedRepoId = result[0].RepoId; await RepoChangedWizard(new ChangeEventArgs { Value = SelectedRepoId }); }
                }
            }
        } finally { StateHasChanged(); }
    }

    private async Task RepoChangedWizard(ChangeEventArgs e)
    {
        ClearLoadingMessages();
        StateHasChanged();
        try {
            SelectedRepoId = e.Value?.ToString() ?? "";
            SelectedBranch = "";
            ResolveSelection();
            if (SelectedProjectInfo != null && SelectedRepoInfo != null) {
                var result = LookupValue(await Helpers.GetOrPost<DataObjects.DevOpsResponse<List<DataObjects.DevopsGitRepoBranchInfo>>>(DevOpsUrl(DataObjects.Endpoints.DevOps.GetDevOpsBranches,
                    ("projectId", SelectedProjectInfo.ProjectId),
                    ("repoId", SelectedRepoInfo.RepoId))));
                if (result != null && result.Any()) {
                    // Only the selected repository keeps its branches.
                    foreach (var repo in SelectedProjectInfo.GitRepos) { repo.GitBranches = repo == SelectedRepoInfo ? result : new List<DataObjects.DevopsGitRepoBranchInfo>(); }
                    if (result.Count == 1) { SelectedBranch = result[0].BranchName; await BranchChangedWizard(new ChangeEventArgs { Value = SelectedBranch }); }
                }
            }
        } finally { StateHasChanged(); }
    }

    private async Task BranchChangedWizard(ChangeEventArgs e)
    {
        ClearLoadingMessages();
        StateHasChanged();
        try {
            SelectedBranch = e.Value?.ToString() ?? "";
            ResolveSelection();
            if (SelectedProjectInfo != null && SelectedRepoInfo != null && SelectedBranchInfo != null) {
                var result = LookupValue(await Helpers.GetOrPost<DataObjects.DevOpsResponse<List<DataObjects.DevopsFileItem>>>(DevOpsUrl(DataObjects.Endpoints.DevOps.GetDevOpsFiles,
                    ("projectId", SelectedProjectInfo.ProjectId),
                    ("repoId", SelectedRepoInfo.RepoId),
                    ("branchName", SelectedBranchInfo.BranchName))));
                if (result != null && result.Any()) {
                    // Only the selected branch keeps its file list.
                    foreach (var branch in SelectedRepoInfo.GitBranches) { branch.Files = branch == SelectedBranchInfo ? result.ToList() : new List<DataObjects.DevopsFileItem>(); }
                    var csprojFiles = CsprojFiles(SelectedBranchInfo);
                    if (csprojFiles.Count == 1) { SelectedCsprojPath = csprojFiles[0].Path; }
                }
            }
        } finally { StateHasChanged(); }
    }

    /// <summary>The .csproj files of a branch's file list, in list order.</summary>
    private static List<DataObjects.DevopsFileItem> CsprojFiles(DataObjects.DevopsGitRepoBranchInfo? branch) =>
        (branch?.Files ?? Enumerable.Empty<DataObjects.DevopsFileItem>()).Where(f => f.FileType.EndsWith(".csproj", StringComparison.OrdinalIgnoreCase)).ToList();

    private void CsProjectFileChangedWizard(ChangeEventArgs e)
    {
        ClearLoadingMessages();
        SelectedCsprojPath = e?.Value?.ToString() ?? "";
        StateHasChanged();
    }

    private void EnvironmentChangedWizard(GlobalSettings.EnvironmentType envKey, ChangeEventArgs e)
    {
        ClearLoadingMessages();
        bool isChecked = e.Value != null && bool.TryParse(e.Value.ToString(), out bool result) && result;
        if (isChecked) {
            string websiteNameDefault = GlobalSettings.App.EnvironmentOptions[envKey]?.Hostname ?? string.Empty;
            EnvSettings[envKey] = new DataObjects.EnvSetting {
                EnvName = envKey, IISDeploymentType = FreeCICD_App_UI_Wizard_StepEnvironments.IisWebApplication, WebsiteName = "" + websiteNameDefault,
                VirtualPath = "/" + SelectedProjectInfo?.ProjectName?.ToLower(),
                AppPoolName = "" + websiteNameDefault + "." + SelectedProjectInfo?.ProjectName?.ToLower(),
                VariableGroupName = $"{SelectedProjectInfo?.ProjectName}_{GlobalSettings.App.VariableGroupNameDefault}_{envKey}"
            };
        } else {
            EnvSettings.Remove(envKey);
        }
        StateHasChanged();
    }

    private void EnvironmentDeploymentTypeChangedWizard(GlobalSettings.EnvironmentType envKey, ChangeEventArgs e)
    {
        ClearLoadingMessages();
        string deploymentType = e.Value?.ToString() ?? "";
        if (EnvSettings.TryGetValue(envKey, out var setting)) {
            setting.IISDeploymentType = deploymentType;
            setting.VirtualPath = FreeCICD_App_UI_Wizard_StepEnvironments.HasVirtualPath(deploymentType) ? "/" + SelectedProjectInfo?.ProjectName?.ToLower() : "";
        }
        StateHasChanged();
    }

    private void PipelineChangedWizard(ChangeEventArgs e)
    {
        ExistingYamlContent = string.Empty;
        NewYamlContent = string.Empty;
        SelectedPipelineId = int.TryParse(e.Value?.ToString(), out int pid) ? pid : 0;
        StateHasChanged();
    }

    private bool _iisPrefetched = false;
    private Dictionary<GlobalSettings.EnvironmentType, DataObjects.IISInfo> _iisData = new();

    /// <summary>
    /// Maps an environment key from the server (IIS info, parsed pipeline settings) to a configured environment: its
    /// enum name, or failing that the first configured environment whose name the key contains (so "AzureDev" is DEV).
    /// </summary>
    private static bool TryMapEnvKeyToEnum(string key, out GlobalSettings.EnvironmentType env)
    {
        env = default;
        if (string.IsNullOrWhiteSpace(key)) return false;
        var k = key.Trim();
        if (Enum.TryParse<GlobalSettings.EnvironmentType>(k, true, out env)) return true;
        foreach (var configured in GlobalSettings.App.EnvironmentOptions.Keys) {
            if (k.Contains(configured.ToString(), StringComparison.OrdinalIgnoreCase)) { env = configured; return true; }
        }
        return false;
    }

    private async Task PrefetchIISDataIfNeeded()
    {
        if (_iisPrefetched) { return; }
        var apiResult = await Helpers.GetOrPost<Dictionary<string, DataObjects.IISInfo>>(DataObjects.Endpoints.DevOps.GetDevOpsIISInfo);
        _iisData.Clear();
        if (apiResult != null) { foreach (var kv in apiResult) { if (TryMapEnvKeyToEnum(kv.Key, out var envKey) && kv.Value != null) { _iisData[envKey] = kv.Value; } } }
        _iisPrefetched = true;
    }

    /// <summary>
    /// The names the environment's IIS scan offers for one field, distinct and sorted ignoring case: site names, the
    /// application paths under <paramref name="websiteName"/>, or app pools (declared pools plus pools named by apps).
    /// </summary>
    private IEnumerable<string> GetIisOptions(GlobalSettings.EnvironmentType envKey, FreeCICD_App_UI_Wizard_StepEnvironments.IisKind field, string websiteName)
    {
        if (!_iisData.TryGetValue(envKey, out var info) || info == null) { return Array.Empty<string>(); }
        var sites = info.Sites ?? new List<DataObjects.Site>();
        IEnumerable<string?> names = field switch {
            FreeCICD_App_UI_Wizard_StepEnvironments.IisKind.Website => sites.Select(s => s?.Name),
            FreeCICD_App_UI_Wizard_StepEnvironments.IisKind.VirtualPath => String.IsNullOrWhiteSpace(websiteName)
                ? Array.Empty<string?>()
                : sites.FirstOrDefault(s => string.Equals(s?.Name ?? string.Empty, websiteName, StringComparison.OrdinalIgnoreCase))?.Applications?.Select(a => a?.Path) ?? Array.Empty<string?>(),
            FreeCICD_App_UI_Wizard_StepEnvironments.IisKind.AppPool => (info.ApplicationPools ?? new List<DataObjects.ApplicationPool>()).Select(ap => ap?.Name)
                .Concat(sites.Where(s => s?.Applications != null).SelectMany(s => s.Applications).Select(a => a?.AppPool)),
            _ => Array.Empty<string?>(),
        };
        return names.Where(n => !string.IsNullOrWhiteSpace(n)).Select(n => n!).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(n => n, StringComparer.OrdinalIgnoreCase);
    }

    /// <summary>
    /// A website, virtual path or app pool picked from the IIS list. A picked value locks the text box to the list;
    /// picking the blank entry unlocks it for a custom value.
    /// </summary>
    private void ApplyIisField(FreeCICD_App_UI_Wizard_StepEnvironments.IisChange change)
    {
        if (EnvSettings.TryGetValue(change.Env, out var setting)) {
            var custom = string.IsNullOrWhiteSpace(change.Value);
            switch (change.Field) {
                case FreeCICD_App_UI_Wizard_StepEnvironments.IisKind.Website: setting.WebsiteName = change.Value; setting.AllowCustomWebsiteName = custom; break;
                case FreeCICD_App_UI_Wizard_StepEnvironments.IisKind.VirtualPath: setting.VirtualPath = change.Value; setting.AllowCustomVirtualPath = custom; break;
                case FreeCICD_App_UI_Wizard_StepEnvironments.IisKind.AppPool: setting.AppPoolName = change.Value; setting.AllowCustomAppPoolName = custom; break;
            }
        }
        StateHasChanged();
    }

    /// <summary>
    /// Resets the wizard to its initial state, clearing all selections and returning to step 0 (or step 1 if logged in).
    /// </summary>
    private void StartOver()
    {
        ClearLoadingMessages();
        
        // Reset all selections
        SelectedProjectId = string.Empty;
        SelectedRepoId = string.Empty;
        SelectedBranch = string.Empty;
        SelectedCsprojPath = string.Empty;
        ResolveSelection();
        SelectedPipelineId = 0;
        NewPipelineName = string.Empty;
        ExistingYamlContent = string.Empty;
        NewYamlContent = string.Empty;
        LastSavedPipelineDefinition = null;
        EnvSettings.Clear();
        VerifyAfterDeploy = true;
        GatherServerInfo = false;

        // Reset save state
        _isSaving = false;
        _saveCompleted = false;
        _saveErrorMessage = string.Empty;
        
        // Reset import state
        _importPipelineId = null;
        _isImporting = false;
        _importCompleted = false;
        _importErrorMessage = string.Empty;
        _parsedSettings = null;
        _importConfidenceScore = 0;
        _importedFields.Clear();
        
        // Reset to appropriate starting step
        if (Model.LoggedIn)
        {
            currentStep = 1; // Skip PAT step for logged-in users
        }
        else
        {
            currentStep = 0;
            DevOpsPAT = string.Empty;
            OrgName = string.Empty;
        }
        
        StateHasChanged();
    }

    /// <summary>
    /// Navigate to a specific step (only allows going back to previously completed steps).
    /// </summary>
    private void GoToStep(int stepIndex)
    {
        if (stepIndex < currentStep && stepIndex >= FirstVisibleStep)
        {
            ClearLoadingMessages();
            currentStep = stepIndex;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Gets the selection summary items for "Your Selections".
    /// </summary>
    private List<SelectionItem> GetSelectionSummary()
    {
        return Steps.Select(s => s.Summary?.Invoke()).OfType<SelectionItem>().ToList();
    }

    /// <summary>One entry of "Your Selections": the step's label and what was chosen.</summary>
    public class SelectionItem
    {
        public string Label { get; set; } = "";
        public string Value { get; set; } = "";
    }

    /// <summary>One line of the "Update Information" table under the step.</summary>
    public class LoadingMessageItem
    {
        public DateTime Created { get; set; } = DateTime.UtcNow;
        public string Message { get; set; } = string.Empty;
    }

    /// <summary>One entry in a step's dropdown: the value sent back on change and the text shown.</summary>
    public sealed record SelectOption(string Value, string Text);

    /// <summary>
    /// Entries ordered by their text ignoring case, the order the project, repository and branch lists use.
    /// </summary>
    public static List<SelectOption> SelectOptionsByText<T>(IEnumerable<T>? items, Func<T, string?> value, Func<T, string?> text)
    {
        return (items ?? Enumerable.Empty<T>())
            .Select(i => new SelectOption(value(i) ?? "", text(i) ?? ""))
            .OrderBy(o => o.Text.ToLower())
            .ToList();
    }

    /// <summary>
    /// A .csproj path without leading or trailing slashes. Azure DevOps lists files as "/src/App.csproj" while the
    /// pipeline variable holds "src/App.csproj", so both forms must reduce to one.
    /// </summary>
    public static string NormalizeCsprojPath(string? path) => (path ?? "").Trim('/', '\\');

    /// <summary>
    /// True when two .csproj paths name the same file. Case is ignored because a path read back from a pipeline's YAML
    /// may differ in case from the file list; the wizard then keeps the file list's own spelling.
    /// </summary>
    public static bool IsSameCsprojPath(string? a, string? b)
    {
        var left = NormalizeCsprojPath(a);
        return !string.IsNullOrWhiteSpace(left) && left.Equals(NormalizeCsprojPath(b), StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// The numbered step circles above the card. Completed steps are green and can be clicked to go back to them;
    /// the current step is blue; each shows its short name and, once reached, the value chosen there.
    /// </summary>
    private RenderFragment RenderStepper() => __builder =>
    {
        var steps = Steps.Skip(FirstVisibleStep).ToList();
        var current = currentStep - FirstVisibleStep;
        <div class="d-flex justify-content-between align-items-start bg-light rounded-3 p-3 mb-3 shadow-sm overflow-auto">
            @for (int i = 0; i < steps.Count; i++) {
                var stepIndex = i;
                var step = steps[i];
                var selectedValue = step.StepperValue();
                var isCompleted = stepIndex < current;
                var isCurrent = stepIndex == current;
                var isClickable = isCompleted;

                <div class="d-flex flex-column align-items-center flex-fill position-relative" style="min-width: 70px;">
                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold border border-2 @(isCompleted ? "bg-success border-success text-white" : isCurrent ? "bg-primary border-primary text-white shadow" : "bg-white border-secondary text-muted") @(isClickable ? "pointer" : "")"
                         style="width: 36px; height: 36px; z-index: 2;"
                         @onclick="@(() => GoToStep(stepIndex + FirstVisibleStep))"
                         title="@(isClickable ? $"Go to {step.Name}" : step.Name)">
                        @if (isCompleted) {
                            <i class="fa fa-check"></i>
                        } else if (isCurrent) {
                            <i class="fa fa-circle fa-xs"></i>
                        } else {
                            <span class="small">@(stepIndex + 1)</span>
                        }
                    </div>

                    @* The line to the next circle *@
                    @if (stepIndex < steps.Count - 1) {
                        <div class="position-absolute @(isCompleted ? "bg-success" : "bg-secondary")"
                             style="height: 3px; top: 18px; left: 50%; width: 100%; z-index: 1; opacity: 0.5;"></div>
                    }

                    <div class="text-center mt-2" style="max-width: 80px;">
                        <div class="small fw-semibold @(isCompleted ? "text-success" : isCurrent ? "text-primary" : "text-muted") text-truncate">
                            @step.ShortName
                        </div>
                        @if (!string.IsNullOrWhiteSpace(selectedValue) && (isCompleted || isCurrent)) {
                            <div class="text-muted small text-truncate" style="font-size: 0.7rem;" title="@selectedValue">
                                @Helpers.MaxStringLength(selectedValue, 8)
                            </div>
                        } else if (isCurrent) {
                            <div class="text-primary small fst-italic" style="font-size: 0.7rem;">(current)</div>
                        }
                    </div>
                </div>
            }
        </div>
    };

    /// <summary>"Your Selections": the choices made in earlier steps as badges; nothing when none has a value.</summary>
    private static RenderFragment RenderSummary(List<SelectionItem> selections) => __builder =>
    {
        @if (selections.Any(s => !string.IsNullOrWhiteSpace(s.Value))) {
            <div class="alert alert-info py-2 px-3 mb-3">
                <div class="d-flex align-items-center mb-2 pb-2 border-bottom border-info border-opacity-25">
                    <i class="fa fa-clipboard-list me-2"></i>
                    <span class="small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Your Selections</span>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var selection in selections.Where(s => !string.IsNullOrWhiteSpace(s.Value))) {
                        <span class="badge bg-white text-dark border shadow-sm py-2 px-3" title="@selection.Value">
                            <span class="text-primary fw-semibold">@selection.Label:</span>
                            <span class="ms-1">@Helpers.MaxStringLength(selection.Value, 37)</span>
                        </span>
                    }
                </div>
            </div>
